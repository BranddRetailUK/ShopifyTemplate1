{
  "name": "modeframe-shopify-theme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "shopify theme check",
    "theme:check": "shopify theme check",
    "theme:dev": "shopify theme dev --theme-editor-sync",
    "theme:info": "shopify theme info",
    "theme:list": "shopify theme list",
    "theme:package": "shopify theme package",
    "theme:push": "shopify theme push",
    "release:check": "node scripts/validate-theme-release.mjs",
    "provenance:check": "node scripts/validate-source-provenance.mjs",
    "qa:static": "node scripts/validate-static-qa.mjs",
    "qa:browser": "playwright test",
    "qa:browser:headed": "playwright test --headed",
    "qa:lighthouse": "node scripts/run-lighthouse.mjs",
    "qa:media": "node scripts/capture-themeforest-media.mjs",
    "qa:creative-market-assets": "node scripts/build-creative-market-assets.mjs",
    "qa:marketplace-site": "playwright test --config playwright.marketplace.config.mjs",
    "qa:marketplace-site:lighthouse": "node scripts/run-marketplace-lighthouse.mjs",
    "license:test": "npm --prefix services/license-api test",
    "marketplace-site:test": "npm --prefix services/marketplace-site test",
    "bundle": "node scripts/build-creative-market-assets.mjs && node scripts/build-marketplace-bundle.mjs",
    "bundle:check": "node scripts/validate-marketplace-bundle.mjs",
    "verify": "npm run lint && npm run release:check && npm run provenance:check && npm run qa:static && npm run license:test && npm run marketplace-site:test",
    "shopify:test-catalog": "node scripts/shopify-test-catalog.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "axe-core": "4.11.4",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "12.6.1"
  }
}
