{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section
  class="collection-list-section section scheme-{{ section.settings.scheme }}"
  data-nav-tone="{{ nav_tone }}"
  style="
    --desktop-columns: {{ section.settings.columns_desktop }};
    --mobile-columns: {{ section.settings.columns_mobile }};
    --grid-gap: {{ section.settings.grid_gap }}px;
  "
>
  <div class="page-width">
    <header class="section-header" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <div class="rte">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="collection-grid">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          <div {{ block.shopify_attributes }}>
            {% render 'collection-card',
              collection: block.settings.collection,
              image: block.settings.image,
              show_count: section.settings.show_product_count
            %}
          </div>
        {% else %}
          {% assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 %}
          <article class="collection-card card" {{ block.shopify_attributes }} data-reveal>
            <div class="collection-card__media">
              {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="collection-card__content">
              <h2>{{ block.settings.placeholder_title | escape }}</h2>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_view_all %}
      <div class="collection-list-section__action">
        <a class="button button--secondary" href="{{ routes.collections_url }}">{{ 'collections.title' | t }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .collection-list-section__action {
    display: flex;
    justify-content: center;
    margin-block-start: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show all collections link",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "placeholder_title",
          "label": "Placeholder title",
          "default": "Collection edit"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
