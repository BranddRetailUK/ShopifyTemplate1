{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section
  class="rich-text-section section scheme-{{ section.settings.scheme }} rich-text-section--{{ section.settings.alignment }}"
  data-nav-tone="{{ nav_tone }}"
>
  <div class="page-width rich-text-section__inner rich-text-section__inner--{{ section.settings.width }}" data-reveal>
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="rte">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .rich-text-section__inner {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .rich-text-section__inner--narrow {
    max-width: min(52rem, calc(var(--page-width) + (var(--page-margin) * 2)));
  }

  .rich-text-section__inner--wide {
    max-width: min(90rem, calc(var(--page-width) + (var(--page-margin) * 2)));
  }

  .rich-text-section__inner h2 {
    max-width: 16ch;
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.86;
  }

  .rich-text-section__inner .rte {
    max-width: 64ch;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
  }

  .rich-text-section--center .rich-text-section__inner {
    justify-items: center;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "Our point of view"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Useful objects can still feel extraordinary."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We begin with how a piece feels, functions, and changes with use—then remove everything it does not need.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "wide", "label": "Wide" }
      ],
      "default": "wide"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
