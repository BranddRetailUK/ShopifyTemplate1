{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section
  class="feature-grid-section section scheme-{{ section.settings.scheme }}"
  data-nav-tone="{{ nav_tone }}"
  style="--feature-columns: {{ section.settings.columns_desktop }}; --feature-gap: {{ section.settings.grid_gap }}px;"
>
  <div class="page-width">
    <header class="section-header" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="feature-grid feature-grid--{{ section.settings.card_style }}">
      {% for block in section.blocks %}
        <article class="feature-grid__item" {{ block.shopify_attributes }} data-reveal>
          {% if block.settings.image %}
            <div class="feature-grid__media">
              {% render 'image',
                image: block.settings.image,
                sizes: '(min-width: 990px) 33vw, 100vw',
                width: 1200
              %}
            </div>
          {% elsif section.settings.show_numbers %}
            <span class="feature-grid__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          {% endif %}
          <div class="feature-grid__content">
            {% if block.settings.eyebrow != blank %}
              <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {% endif %}
            <h3>{{ block.settings.heading | escape }}</h3>
            {% if block.settings.text != blank %}
              <div class="rte">{{ block.settings.text }}</div>
            {% endif %}
            {% if block.settings.link_label != blank %}
              <a class="text-link" href="{{ block.settings.link }}">
                {{ block.settings.link_label | escape }}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .feature-grid {
    display: grid;
    gap: var(--feature-gap);
  }

  .feature-grid__item {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 1.25rem;
    border-block-start: 1px solid var(--border-subtle);
    padding-block-start: 1.25rem;
  }

  .feature-grid--cards .feature-grid__item {
    border: 1px solid var(--border-subtle);
    border-radius: var(--card-radius);
    padding: 1rem;
  }

  .feature-grid__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--media-radius);
  }

  .feature-grid__media .image,
  .feature-grid__media img {
    width: 100%;
    height: 100%;
  }

  .feature-grid__media img {
    object-fit: cover;
  }

  .feature-grid__number {
    font-family: var(--font-heading-family);
    font-size: clamp(3.5rem, 7vw, 7rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: -0.08em;
    line-height: 0.8;
    opacity: 0.55;
  }

  .feature-grid__content {
    display: grid;
    gap: 0.8rem;
  }

  .feature-grid__content h3 {
    font-size: clamp(1.5rem, 3vw, 2.8rem);
    line-height: 0.95;
  }

  @media (min-width: 750px) {
    .feature-grid {
      grid-template-columns: repeat(var(--feature-columns, 3), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature grid",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom background"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Override preset background",
      "info": "Uses the color below for this section instead of the selected color scheme background.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What matters"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A clear reason to choose your brand."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Item style",
      "options": [
        { "value": "lines", "label": "Dividers" },
        { "value": "cards", "label": "Cards" }
      ],
      "default": "lines"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbers when no image is set",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Describe a key benefit"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Explain the useful detail behind this part of your offer.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Feature grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "heading": "Made with intent",
            "text": "<p>Explain your materials, process, or design decision.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Easy to live with",
            "text": "<p>Show how the product earns a place in everyday life.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "heading": "Supported properly",
            "text": "<p>Set a clear expectation for delivery, care, and support.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
