{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section
  class="cart-page section scheme-{{ section.settings.scheme }}"
  data-nav-tone="{{ nav_tone }}"
>
  <div class="page-width">
    <header class="cart-page__header" data-reveal>
      <p class="eyebrow">{{ 'cart.general.cart' | t }}</p>
      <h1>{{ 'cart.general.title' | t }}</h1>
      {% if cart.item_count > 0 %}
        <p>{{ 'cart.general.item_count' | t: count: cart.item_count }}</p>
      {% endif %}
    </header>

    {% if cart.item_count == 0 %}
      <div class="empty-state">
        <h2>{{ 'cart.general.empty' | t }}</h2>
        <a class="button" href="{{ routes.all_products_collection_url }}">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {% else %}
      <form class="cart-page__form" action="{{ routes.cart_url }}" method="post" id="CartForm">
        <div class="cart-page__items">
          {% for item in cart.items %}
            <article class="cart-line" data-cart-line="{{ forloop.index }}">
              <span class="cart-line__index" aria-hidden="true">
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              </span>
              <a class="cart-line__media" href="{{ item.url }}">
                {% if item.image %}
                  {% render 'image',
                    image: item.image,
                    sizes: '(min-width: 750px) 180px, 110px',
                    width: 500
                  %}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </a>

              <div class="cart-line__content">
                {% if section.settings.show_vendor and item.product.vendor != blank %}
                  <p class="eyebrow">{{ item.product.vendor }}</p>
                {% endif %}
                <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>

                {% unless item.product.has_only_default_variant %}
                  <dl class="cart-line__options">
                    {% for option in item.options_with_values %}
                      <div>
                        <dt>{{ option.name | escape }}:</dt>
                        <dd>{{ option.value | escape }}</dd>
                      </div>
                    {% endfor %}
                  </dl>
                {% endunless %}

                {% if item.selling_plan_allocation %}
                  <p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                  {% if item.selling_plan_allocation.checkout_charge_amount != item.final_price %}
                    {% assign checkout_charge = item.selling_plan_allocation.checkout_charge_amount | money %}
                    <p>{{ 'products.product.due_at_checkout' | t: amount: checkout_charge }}</p>
                  {% endif %}
                {% endif %}

                {% for property in item.properties %}
                  {% assign property_first_character = property.first | slice: 0 %}
                  {% if property.last != blank and property_first_character != '_' %}
                    <p class="cart-line__property">
                      {{ property.first | escape }}:
                      {% if property.last contains '/uploads/' %}
                        <a href="{{ property.last | escape }}">{{ property.last | split: '/' | last | escape }}</a>
                      {% else %}
                        {{ property.last | escape }}
                      {% endif %}
                    </p>
                  {% endif %}
                {% endfor %}

                {% if item.line_level_discount_allocations.size > 0 %}
                  <ul class="cart-line__discounts" role="list">
                    {% for discount_allocation in item.line_level_discount_allocations %}
                      <li>
                        {% render 'icon', name: 'check' %}
                        {{ discount_allocation.discount_application.title | escape }}
                        (-{{ discount_allocation.amount | money }})
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>

              <div class="cart-line__actions">
                <div class="cart-line__price">
                  <span>{{ item.final_price | money }} × {{ item.quantity }}</span>
                  {% if item.original_line_price != item.final_line_price %}
                    <s>{{ item.original_line_price | money }}</s>
                  {% endif %}
                  <strong>{{ item.final_line_price | money }}</strong>
                  {% if item.unit_price_measurement %}
                    <small>
                      {{ item.unit_price | money }} /
                      {% if item.unit_price_measurement.reference_value != 1 %}
                        {{ item.unit_price_measurement.reference_value }}
                      {% endif %}
                      {{ item.unit_price_measurement.reference_unit }}
                    </small>
                  {% endif %}
                </div>

                {% render 'quantity-input',
                  value: item.quantity,
                  name: 'updates[]',
                  id: item.key,
                  min: item.variant.quantity_rule.min,
                  max: item.variant.quantity_rule.max,
                  step: item.variant.quantity_rule.increment,
                  form: 'CartForm'
                %}

                <a class="text-link" href="{{ item.url_to_remove }}" aria-label="{{ 'cart.general.remove_item' | t: title: item.title }}">
                  {{ 'cart.general.remove' | t }}
                </a>
              </div>
            </article>
          {% endfor %}

          <button class="button button--secondary cart-page__update" type="submit" name="update">
            {{ 'cart.general.update' | t }}
          </button>
          <p class="form-status" role="alert" hidden data-cart-errors>{{ 'cart.general.error' | t }}</p>
        </div>

        <aside class="cart-summary">
          {% if section.settings.show_cart_note %}
            <div class="field">
              <label for="CartNote">{{ 'cart.general.note' | t }}</label>
              <textarea id="CartNote" name="note" rows="4">{{ cart.note | escape }}</textarea>
            </div>
          {% endif %}

          {% if cart.cart_level_discount_applications.size > 0 %}
            <ul class="cart-summary__discounts" role="list">
              {% for discount_application in cart.cart_level_discount_applications %}
                <li>
                  <span>
                    {% render 'icon', name: 'check' %}
                    {{ discount_application.title | escape }}
                  </span>
                  <span>-{{ discount_application.total_allocated_amount | money }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          <div class="cart-summary__subtotal">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money_with_currency }}</strong>
          </div>

          <p class="cart-summary__tax">
            {% if cart.taxes_included %}
              {{ 'cart.general.taxes_included' | t }}
            {% else %}
              {{ 'cart.general.taxes_and_shipping_at_checkout' | t }}
            {% endif %}
          </p>

          {% if section.settings.show_terms %}
            <label class="cart-summary__terms">
              <input type="checkbox" required>
              <span>{{ section.settings.terms_text }}</span>
            </label>
          {% endif %}

          <button class="button cart-summary__checkout" type="submit" name="checkout">
            {{ 'cart.general.checkout' | t }}
          </button>

          {% if additional_checkout_buttons and section.settings.show_dynamic_checkout %}
            <div class="cart-summary__dynamic">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {% endif %}

          {% if section.settings.continue_shopping_link != blank %}
            <a class="text-link cart-summary__continue" href="{{ section.settings.continue_shopping_link }}">
              {{ 'general.continue_shopping' | t }}
            </a>
          {% endif %}
        </aside>
      </form>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cart-page__header {
    display: grid;
    gap: 0.75rem;
    margin-block-end: clamp(2rem, 6vw, 5rem);
  }

  .cart-page__header h1 {
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.86;
  }

  .cart-page__form {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .cart-page__items {
    min-width: 0;
  }

  .cart-line {
    display: grid;
    grid-template-columns: 2rem 9rem minmax(0, 1fr) auto;
    gap: 1.25rem;
    border-block-start: 1px solid var(--border-subtle);
    padding-block: 1.25rem;
  }

  .cart-line__index {
    padding-block-start: 0.25rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .cart-line:last-of-type {
    border-block-end: 1px solid var(--border-subtle);
  }

  .cart-line__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--media-radius);
    background: color-mix(in srgb, currentcolor 6%, transparent);
  }

  .cart-line__media .image,
  .cart-line__media img,
  .cart-line__media .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .cart-line__media img {
    object-fit: cover;
  }

  .cart-line__content {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }

  .cart-line__content h2 {
    font-size: clamp(1.2rem, 2.5vw, 2rem);
  }

  .cart-line__content h2 a {
    text-decoration: none;
  }

  .cart-line__options {
    display: grid;
    gap: 0.2rem;
    font-size: 0.82rem;
  }

  .cart-line__options div {
    display: flex;
    gap: 0.35rem;
  }

  .cart-line__options dt {
    font-weight: 700;
  }

  .cart-line__discounts,
  .cart-summary__discounts {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
  }

  .cart-line__discounts li,
  .cart-summary__discounts span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .cart-line__discounts .icon,
  .cart-summary__discounts .icon {
    width: 0.8rem;
  }

  .cart-line__actions {
    display: grid;
    min-width: 9rem;
    justify-items: end;
    align-content: space-between;
    gap: 1rem;
  }

  .cart-line__price {
    display: grid;
    justify-items: end;
  }

  .cart-line__price small,
  .cart-line__price s {
    opacity: 0.65;
  }

  .cart-page__update {
    margin-block-start: 1.25rem;
  }

  .cart-summary {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--card-radius);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .cart-summary__discounts li,
  .cart-summary__subtotal {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .cart-summary__subtotal {
    border-block-start: 1px solid var(--border-subtle);
    padding-block-start: 1rem;
    font-size: 1.2rem;
  }

  .cart-summary__tax {
    font-size: 0.78rem;
    opacity: 0.7;
  }

  .cart-summary__terms {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.82rem;
  }

  .cart-summary__terms input {
    width: 1rem;
    min-height: 1rem;
    margin-block-start: 0.2rem;
  }

  .cart-summary__checkout,
  .cart-summary__continue {
    width: 100%;
    text-align: center;
  }

  @media (min-width: 990px) {
    .cart-page__form {
      grid-template-columns: minmax(0, 1.65fr) minmax(20rem, 0.75fr);
    }

    .cart-summary {
      position: sticky;
      inset-block-start: calc(var(--header-height) + 2rem);
    }
  }

  @media (max-width: 749px) {
    .cart-line {
      grid-template-columns: 1.5rem 6.5rem minmax(0, 1fr);
    }

    .cart-line__actions {
      grid-column: 3;
      grid-template-columns: 1fr auto;
      justify-items: start;
    }

    .cart-line__price {
      grid-column: 1 / -1;
      justify-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "Show order note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show accelerated checkout buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_terms",
      "label": "Require terms confirmation",
      "default": false
    },
    {
      "type": "richtext",
      "id": "terms_text",
      "label": "Terms confirmation text",
      "default": "<p>I agree to the terms and conditions.</p>"
    },
    {
      "type": "url",
      "id": "continue_shopping_link",
      "label": "Continue shopping link"
    }
  ]
}
{% endschema %}
