{% render 'section-background-override', section: section %}

{% liquid
  assign featured_collection = section.settings.collection
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section
  class="featured-collection featured-collection--{{ section.settings.layout }} section scheme-{{ section.settings.scheme }}"
  data-nav-tone="{{ nav_tone }}"
  style="
    --desktop-columns: {{ section.settings.columns_desktop }};
    --mobile-columns: {{ section.settings.columns_mobile }};
    --grid-gap: {{ section.settings.grid_gap }}px;
  "
>
  <div class="page-width">
    <header class="section-header section-header--with-action" data-reveal>
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ section.settings.heading | default: featured_collection.title | escape }}</h2>
        {% if section.settings.text != blank %}
          <div class="rte">{{ section.settings.text }}</div>
        {% endif %}
      </div>
      {% if section.settings.show_view_all and featured_collection != blank %}
        <a class="text-link" href="{{ featured_collection.url }}">{{ 'general.view_all' | t }}</a>
      {% endif %}
    </header>

    <div class="product-grid{% if section.settings.mobile_scroll %} product-grid--mobile-scroll{% endif %}">
      {% if featured_collection != blank %}
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          {% liquid
            assign eager_card = false
            if forloop.index <= section.settings.columns_desktop
              assign eager_card = true
            endif
            assign card_class = ''
            if section.settings.layout == 'editorial' and forloop.first
              assign card_class = 'product-card--lead'
            endif
          %}
          {% render 'product-card',
            product: product,
            eager: eager_card,
            index: forloop.index,
            class: card_class
          %}
        {% endfor %}
      {% else %}
        {% for index in (1..section.settings.products_to_show) %}
          {% assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 %}
          <article class="product-card card" data-reveal>
            <div class="product-card__media">
              {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="product-card__content">
              <h3>{{ 'onboarding.product_title' | t }}</h3>
              <div class="price">{{ 1999 | money }}</div>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .featured-collection--editorial .product-grid {
    align-items: stretch;
  }

  .featured-collection--editorial .product-card--lead {
    grid-column: span 2;
    grid-row: span 2;
  }

  .featured-collection--editorial .product-card--lead .product-card__media {
    flex: 1;
    min-height: 34rem;
    aspect-ratio: auto;
  }

  @media (max-width: 749px) {
    .featured-collection--editorial .product-card--lead {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .featured-collection--editorial .product-card--lead .product-card__media {
      min-height: 62vh;
    }

    .product-grid--mobile-scroll {
      grid-auto-columns: minmax(72vw, 1fr);
      grid-template-columns: none;
      grid-auto-flow: column;
      overflow-x: auto;
      margin-inline: calc(var(--page-margin) * -1);
      padding-inline: var(--page-margin);
      scroll-snap-type: x mandatory;
    }

    .product-grid--mobile-scroll > * {
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Product layout",
      "options": [
        { "value": "editorial", "label": "Editorial lead" },
        { "value": "grid", "label": "Equal grid" }
      ],
      "default": "editorial"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "Selected for you"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "mobile_scroll",
      "label": "Enable mobile swipe",
      "default": false
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
