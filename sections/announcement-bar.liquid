{% render 'section-background-override', section: section %}

{% if section.blocks.size > 0 %}
  <aside
    class="announcement-bar scheme-{{ section.settings.scheme }}"
    aria-label="Announcements"
    data-nav-tone="{{ section.settings.scheme | replace: 'paper', 'light' | replace: 'signal', 'light' | replace: 'ink', 'dark' | replace: 'electric', 'dark' }}"
  >
    <div class="announcement-bar__inner">
      {% for block in section.blocks %}
        <p {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {% else %}
            {{ block.settings.text | escape }}
          {% endif %}
        </p>
      {% endfor %}
    </div>
  </aside>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    position: relative;
    z-index: 31;
    padding: 0.55rem var(--page-margin);
    background: var(--scheme-background);
    color: var(--scheme-foreground);
  }

  .announcement-bar__inner {
    display: flex;
    max-width: var(--page-width);
    justify-content: center;
    margin-inline: auto;
    text-align: center;
  }

  .announcement-bar p {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .announcement-bar p:not(:first-child) {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "signal"
    },
    {
      "type": "header",
      "content": "Custom background"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Override preset background",
      "info": "Uses the color below for this section instead of the selected color scheme background.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free delivery on qualifying orders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
