{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section class="collapsible-section section scheme-{{ section.settings.scheme }}" data-nav-tone="{{ nav_tone }}">
  <div class="page-width collapsible-section__inner">
    <header class="collapsible-section__header" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <div class="rte">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="collapsible-section__items">
      {% for block in section.blocks %}
        <details class="collapsible-row" {{ block.shopify_attributes }} {% if section.settings.open_first and forloop.first %}open{% endif %}>
          <summary>
            <span>{{ block.settings.heading | escape }}</span>
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="rte collapsible-row__content">{{ block.settings.text }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .collapsible-section__inner {
    display: grid;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .collapsible-section__header {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .collapsible-section__header h2 {
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.86;
  }

  .collapsible-section__items {
    border-block-start: 1px solid var(--border-subtle);
  }

  .collapsible-row {
    border-block-end: 1px solid var(--border-subtle);
  }

  .collapsible-row summary {
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    font-family: var(--font-heading-family);
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    font-weight: var(--font-heading-weight);
    list-style: none;
  }

  .collapsible-row summary::-webkit-details-marker {
    display: none;
  }

  .collapsible-row summary .icon {
    width: 1.2rem;
    transition: transform 180ms ease;
  }

  .collapsible-row[open] summary .icon {
    transform: rotate(45deg);
  }

  .collapsible-row__content {
    max-width: 64ch;
    padding-block: 0 1.5rem;
  }

  @media (min-width: 990px) {
    .collapsible-section__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(28rem, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collapsible content",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom background"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Override preset background",
      "info": "Uses the color below for this section instead of the selected color scheme background.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions, answered."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first row",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Add a common customer question"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Answer",
          "default": "<p>Give a useful, direct answer and link to a policy page when more detail is needed.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collapsible content",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
