{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif

  assign stage_image = section.settings.image
  if stage_image == blank
    assign stage_image = section.settings.mobile_image
  endif
%}

<section
  class="shoppable-lookbook section scheme-{{ section.settings.scheme }}"
  data-nav-tone="{{ nav_tone }}"
  style="--lookbook-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="page-width">
    <header class="shoppable-lookbook__header" data-reveal>
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
      </div>

      {% if section.settings.text != blank %}
        <div class="rte shoppable-lookbook__introduction">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    <div class="shoppable-lookbook__composition shoppable-lookbook__composition--{{ section.settings.list_position }}">
      <div
        class="shoppable-lookbook__stage shoppable-lookbook__stage--{{ section.settings.media_ratio }}"
        data-reveal
      >
        <div class="shoppable-lookbook__media">
          {% if stage_image != blank %}
            <picture>
              {% if section.settings.mobile_image != blank and section.settings.image != blank %}
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
                    {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
                    {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w
                  "
                >
              {% endif %}
              {{
                stage_image
                | image_url: width: 2200
                | image_tag:
                  widths: '750, 1100, 1500, 1800, 2200',
                  sizes: '(min-width: 990px) 72vw, 100vw',
                  loading: 'lazy',
                  alt: stage_image.alt
              }}
            </picture>
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          <span class="shoppable-lookbook__overlay"></span>
        </div>

        {% for block in section.blocks %}
          {% liquid
            assign hotspot_product = block.settings.product
            assign hotspot_title = block.settings.label
            if hotspot_title == blank and hotspot_product != blank
              assign hotspot_title = hotspot_product.title
            endif
            if hotspot_title == blank
              assign hotspot_title = 'onboarding.product_title' | t
            endif

            assign card_alignment = block.settings.card_alignment
            if card_alignment == 'auto'
              if block.settings.x_position < 31
                assign card_alignment = 'start'
              elsif block.settings.x_position > 69
                assign card_alignment = 'end'
              else
                assign card_alignment = 'center'
              endif
            endif

            assign card_vertical = 'below'
            if block.settings.y_position > 64
              assign card_vertical = 'above'
            endif
          %}
          <details
            class="shoppable-lookbook__hotspot shoppable-lookbook__hotspot--{{ card_alignment }} shoppable-lookbook__hotspot--{{ card_vertical }}"
            style="--hotspot-x: {{ block.settings.x_position }}%; --hotspot-y: {{ block.settings.y_position }}%;"
            {{ block.shopify_attributes }}
          >
            <summary>
              <span aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
              <span class="visually-hidden">{{ hotspot_title | escape }}</span>
            </summary>

            <article class="shoppable-lookbook__popover">
              {% if hotspot_product != blank %}
                {% if hotspot_product.featured_media %}
                  {% render 'image',
                    image: hotspot_product.featured_media.preview_image,
                    url: hotspot_product.url,
                    sizes: '240px',
                    width: 480,
                    alt: hotspot_product.featured_media.alt | default: hotspot_product.title
                  %}
                {% endif %}
                <div class="shoppable-lookbook__product-copy">
                  <h3><a href="{{ hotspot_product.url }}">{{ hotspot_product.title | escape }}</a></h3>
                  {% render 'price', product: hotspot_product %}
                  <a class="text-link" href="{{ hotspot_product.url }}">
                    {{ 'products.product.view_details' | t }}
                  </a>
                </div>
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                <div class="shoppable-lookbook__product-copy">
                  <h3>{{ 'onboarding.product_title' | t }}</h3>
                  <div class="price">{{ 1999 | money }}</div>
                  <p>{{ 'onboarding.choose_product' | t }}</p>
                </div>
              {% endif %}
            </article>
          </details>
        {% endfor %}
      </div>

      <div class="shoppable-lookbook__index" data-reveal>
        {% if section.blocks.size > 0 %}
          <ol role="list">
            {% for block in section.blocks %}
              {% assign index_product = block.settings.product %}
              <li>
                <span class="shoppable-lookbook__index-number" aria-hidden="true">
                  {{ forloop.index | prepend: '0' }}
                </span>

                {% if index_product != blank %}
                  {% render 'product-card',
                    product: index_product,
                    class: 'shoppable-lookbook__indexed-product',
                    heading_level: 'h3'
                  %}
                {% else %}
                  <div class="shoppable-lookbook__indexed-fallback">
                    <div class="shoppable-lookbook__index-placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                    <div class="shoppable-lookbook__index-copy">
                      <h3>{{ 'onboarding.product_title' | t }}</h3>
                      <p>{{ 'onboarding.choose_product' | t }}</p>
                    </div>
                  </div>
                {% endif %}
              </li>
            {% endfor %}
          </ol>
        {% else %}
          <div class="shoppable-lookbook__empty">
            <span class="shoppable-lookbook__index-number" aria-hidden="true">01</span>
            <p>{{ 'onboarding.choose_product' | t }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .shoppable-lookbook__header {
    display: grid;
    align-items: end;
    gap: clamp(1.5rem, 5vw, 5rem);
    margin-block-end: clamp(2rem, 6vw, 5rem);
  }

  .shoppable-lookbook__header > div:first-child {
    display: grid;
    gap: 1rem;
  }

  .shoppable-lookbook__header h2 {
    max-width: 12ch;
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.84;
  }

  .shoppable-lookbook__introduction {
    max-width: 48ch;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
  }

  .shoppable-lookbook__composition {
    display: grid;
    align-items: stretch;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .shoppable-lookbook__stage {
    position: relative;
    min-height: 32rem;
    isolation: isolate;
  }

  .shoppable-lookbook__stage--landscape {
    aspect-ratio: 16 / 11;
  }

  .shoppable-lookbook__stage--portrait {
    aspect-ratio: 4 / 5;
  }

  .shoppable-lookbook__stage--square {
    aspect-ratio: 1;
  }

  .shoppable-lookbook__media {
    position: absolute;
    overflow: hidden;
    border-radius: var(--card-radius);
    background: color-mix(in srgb, currentcolor 6%, transparent);
    inset: 0;
  }

  .shoppable-lookbook__media picture,
  .shoppable-lookbook__media img,
  .shoppable-lookbook__media .placeholder-svg,
  .shoppable-lookbook__overlay {
    width: 100%;
    height: 100%;
  }

  .shoppable-lookbook__media img,
  .shoppable-lookbook__media .placeholder-svg {
    object-fit: cover;
  }

  .shoppable-lookbook__overlay {
    position: absolute;
    background: rgb(0 0 0 / var(--lookbook-overlay, 0));
    inset: 0;
    pointer-events: none;
  }

  .shoppable-lookbook__hotspot {
    position: absolute;
    z-index: 2;
    inset-block-start: var(--hotspot-y);
    inset-inline-start: var(--hotspot-x);
    width: 3rem;
    height: 3rem;
    transform: translate(-50%, -50%);
  }

  .shoppable-lookbook__hotspot[open] {
    z-index: 5;
  }

  .shoppable-lookbook__hotspot summary {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 2px solid var(--scheme-background);
    border-radius: 999px;
    background: var(--scheme-foreground);
    box-shadow: 0 0.7rem 2rem rgb(0 0 0 / 20%);
    color: var(--scheme-background);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    list-style: none;
  }

  .shoppable-lookbook__hotspot summary::-webkit-details-marker {
    display: none;
  }

  .shoppable-lookbook__hotspot[open] summary {
    outline: 3px solid var(--scheme-foreground);
    outline-offset: 3px;
  }

  .shoppable-lookbook__popover {
    position: absolute;
    inset-block-start: calc(100% + 0.75rem);
    display: grid;
    width: min(18rem, calc(100vw - (var(--page-margin) * 2)));
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--card-radius);
    background: var(--scheme-background);
    box-shadow: var(--shadow-soft);
    color: var(--scheme-foreground);
  }

  .shoppable-lookbook__hotspot--above .shoppable-lookbook__popover {
    inset-block-start: auto;
    inset-block-end: calc(100% + 0.75rem);
  }

  .shoppable-lookbook__hotspot--start .shoppable-lookbook__popover {
    inset-inline-start: 0;
  }

  .shoppable-lookbook__hotspot--center .shoppable-lookbook__popover {
    inset-inline-start: 50%;
    transform: translateX(-50%);
  }

  .shoppable-lookbook__hotspot--end .shoppable-lookbook__popover {
    inset-inline-end: 0;
  }

  .shoppable-lookbook__popover .modeframe-media,
  .shoppable-lookbook__popover > .placeholder-svg {
    width: 100%;
    aspect-ratio: 4 / 3;
  }

  .shoppable-lookbook__popover > .placeholder-svg {
    background: color-mix(in srgb, currentcolor 6%, transparent);
  }

  .shoppable-lookbook__product-copy {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
  }

  .shoppable-lookbook__product-copy h3,
  .shoppable-lookbook__index-copy h3 {
    font-size: 1rem;
    line-height: 1.1;
  }

  .shoppable-lookbook__product-copy h3 a,
  .shoppable-lookbook__index-copy h3 a {
    text-decoration: none;
  }

  .shoppable-lookbook__index {
    min-width: 0;
    border-block: 1px solid var(--border-subtle);
  }

  .shoppable-lookbook__index ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shoppable-lookbook__index li,
  .shoppable-lookbook__empty {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
    border-block-end: 1px solid var(--border-subtle);
    padding-block: 0.9rem;
  }

  .shoppable-lookbook__index li:last-child {
    border-block-end: 0;
  }

  .shoppable-lookbook__index-number {
    align-self: start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .shoppable-lookbook__index .shoppable-lookbook__indexed-product {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .shoppable-lookbook__index .shoppable-lookbook__indexed-product .product-card__media {
    width: 5rem;
    aspect-ratio: 4 / 5;
    border-radius: calc(var(--card-radius) * 0.65);
  }

  .shoppable-lookbook__index .shoppable-lookbook__indexed-product .product-card__content {
    align-content: center;
    gap: 0.45rem;
    padding: 0;
  }

  .shoppable-lookbook__index .shoppable-lookbook__indexed-product .product-card__quick-add {
    display: none;
  }

  .shoppable-lookbook__indexed-fallback {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
  }

  .shoppable-lookbook__index-media,
  .shoppable-lookbook__index-placeholder {
    width: 5rem;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: calc(var(--card-radius) * 0.65);
    background: color-mix(in srgb, currentcolor 6%, transparent);
  }

  .shoppable-lookbook__index-placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .shoppable-lookbook__index-copy {
    display: grid;
    min-width: 0;
    gap: 0.45rem;
  }

  .shoppable-lookbook__index-copy .price,
  .shoppable-lookbook__index-copy p {
    font-size: 0.78rem;
  }

  .shoppable-lookbook__empty {
    grid-template-columns: auto minmax(0, 1fr);
    min-height: 8rem;
  }

  @media (min-width: 990px) {
    .shoppable-lookbook__header {
      grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.7fr);
    }

    .shoppable-lookbook__composition {
      grid-template-columns: minmax(0, 2.25fr) minmax(18rem, 0.75fr);
    }

    .shoppable-lookbook__composition--left {
      grid-template-columns: minmax(18rem, 0.75fr) minmax(0, 2.25fr);
    }

    .shoppable-lookbook__composition--left .shoppable-lookbook__stage {
      grid-column: 2;
    }

    .shoppable-lookbook__composition--left .shoppable-lookbook__index {
      grid-column: 1;
      grid-row: 1;
    }

    .shoppable-lookbook__index {
      max-height: 100%;
      overflow-y: auto;
    }
  }

  @media (max-width: 989px) {
    .shoppable-lookbook__stage {
      min-height: 30rem;
    }

    .shoppable-lookbook__index ol {
      grid-auto-columns: minmax(17rem, 78vw);
      grid-template-columns: none;
      grid-auto-flow: column;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .shoppable-lookbook__index li {
      border-inline-end: 1px solid var(--border-subtle);
      border-block-end: 0;
      padding-inline: 0.9rem;
      scroll-snap-align: start;
    }
  }

  @media (max-width: 749px) {
    .shoppable-lookbook__stage {
      min-height: 28rem;
      aspect-ratio: 4 / 5;
    }

    .shoppable-lookbook__hotspot summary,
    .shoppable-lookbook__hotspot {
      width: 2.75rem;
      height: 2.75rem;
    }

    .shoppable-lookbook__popover {
      width: min(16rem, calc(100vw - (var(--page-margin) * 2)));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shoppable lookbook",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "Shop the composition"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The edit, in context."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Connect the products in a campaign image and give customers a direct route from inspiration to detail.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "2000 x 1400px recommended"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional portrait crop"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Desktop image ratio",
      "options": [
        { "value": "landscape", "label": "Landscape" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "list_position",
      "label": "Product index position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessible label",
          "info": "Uses the product title when left blank."
        },
        {
          "type": "range",
          "id": "x_position",
          "label": "Horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y_position",
          "label": "Vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "select",
          "id": "card_alignment",
          "label": "Product card alignment",
          "options": [
            { "value": "auto", "label": "Automatic" },
            { "value": "start", "label": "Open right" },
            { "value": "center", "label": "Open centered" },
            { "value": "end", "label": "Open left" }
          ],
          "default": "auto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable lookbook",
      "blocks": [
        { "type": "hotspot", "settings": { "x_position": 24, "y_position": 34 } },
        { "type": "hotspot", "settings": { "x_position": 58, "y_position": 56 } },
        { "type": "hotspot", "settings": { "x_position": 80, "y_position": 28 } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
