{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif

  assign related_blog = section.settings.related_blog
  if related_blog == blank
    assign related_blog = blog
  endif
  assign related_story_count = 0
  if section.settings.show_related_articles and related_blog != blank
    for related_story in related_blog.articles
      unless related_story.id == article.id
        assign related_story_count = related_story_count | plus: 1
        if related_story_count >= section.settings.related_articles_count
          break
        endif
      endunless
    endfor
  endif

  assign has_related_products = false
  if section.settings.show_related_products and section.settings.related_collection != blank
    if section.settings.related_collection.products_count > 0
      assign has_related_products = true
    endif
  endif
%}

<article class="article-main scheme-{{ section.settings.scheme }}" data-nav-tone="{{ nav_tone }}">
  <header class="article-main__header page-width" data-reveal>
    <a class="eyebrow" href="{{ blog.url }}">{{ blog.title | escape }}</a>
    <h1>{{ article.title | escape }}</h1>
    <div class="article-main__meta">
      {% if section.settings.show_date %}
        {{ article.published_at | time_tag: format: 'date' }}
      {% endif %}
      {% if section.settings.show_author %}
        <span>{{ article.author | escape }}</span>
      {% endif %}
      {% if article.tags.size > 0 and section.settings.show_tags %}
        <span>{{ article.tags | join: ', ' }}</span>
      {% endif %}
    </div>
  </header>

  {% if article.image and section.settings.show_image %}
    <div class="article-main__hero page-width{% if section.settings.full_width_image %} page-width--full{% endif %}" data-reveal>
      {% render 'image',
        image: article.image,
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        width: 2400
      %}
    </div>
  {% endif %}

  <div class="article-main__body page-width">
    <div class="rte article-main__content">{{ article.content }}</div>

    {% if section.settings.show_share %}
      <div class="article-main__share">
        <span class="eyebrow">{{ 'general.share' | t }}</span>
        <a
          href="//www.facebook.com/sharer.php?u={{ shop.url | append: article.url | url_encode }}"
          target="_blank"
          rel="noopener"
        >
          Facebook
        </a>
        <a
          href="//pinterest.com/pin/create/button/?url={{ shop.url | append: article.url | url_encode }}{% if article.image %}&media={{ article.image | image_url: width: 1200 | url_encode }}{% endif %}"
          target="_blank"
          rel="noopener"
        >
          Pinterest
        </a>
      </div>
    {% endif %}
  </div>

  {% if related_story_count > 0 or has_related_products %}
    <div class="article-main__routes page-width">
      {% if related_story_count > 0 %}
        <section class="article-route" aria-labelledby="RelatedStories-{{ section.id }}">
          <header class="article-route__header">
            <h2 id="RelatedStories-{{ section.id }}">{{ section.settings.related_articles_heading | escape }}</h2>
            <a class="text-link" href="{{ related_blog.url }}">{{ 'general.view_all' | t }}</a>
          </header>

          <div class="article-route__stories">
            {% assign rendered_story_count = 0 %}
            {% for related_story in related_blog.articles %}
              {% unless related_story.id == article.id %}
                {% assign rendered_story_count = rendered_story_count | plus: 1 %}
                {% render 'article-card',
                  article: related_story,
                  show_author: section.settings.show_author,
                  show_date: section.settings.show_date,
                  show_excerpt: false,
                  index: rendered_story_count,
                  heading_level: 'h3',
                  class: 'article-card--compact'
                %}
                {% if rendered_story_count >= section.settings.related_articles_count %}
                  {% break %}
                {% endif %}
              {% endunless %}
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if has_related_products %}
        <section class="article-route" aria-labelledby="RelatedProducts-{{ section.id }}">
          <header class="article-route__header">
            <h2 id="RelatedProducts-{{ section.id }}">{{ section.settings.related_products_heading | escape }}</h2>
            <a class="text-link" href="{{ section.settings.related_collection.url }}">{{ 'general.view_all' | t }}</a>
          </header>

          <div
            class="article-route__products"
            style="--related-product-columns: {{ section.settings.related_products_count }};"
          >
            {% for related_product in section.settings.related_collection.products limit: section.settings.related_products_count %}
              {% render 'product-card',
                product: related_product,
                index: forloop.index,
                heading_level: 'h3'
              %}
            {% endfor %}
          </div>
        </section>
      {% endif %}
    </div>
  {% endif %}

  {% if blog.comments_enabled? %}
    <section class="article-comments page-width" id="comments">
      <div class="article-comments__inner">
        <h2>{{ 'blog.article_comments' | t }} ({{ article.comments_count }})</h2>

        {% paginate article.comments by 10 %}
          <div class="article-comments__list">
            {% for comment in article.comments %}
              <blockquote class="article-comment">
                <div class="rte">{{ comment.content }}</div>
                <footer>
                  <strong>{{ comment.author | escape }}</strong>
                  {{ comment.created_at | time_tag: format: 'date' }}
                </footer>
              </blockquote>
            {% endfor %}
          </div>
          {% render 'pagination', paginate: paginate, anchor: '#comments' %}
        {% endpaginate %}

        {% form 'new_comment', article, class: 'article-comment-form' %}
          <h2>{{ 'blog.comment_form_title' | t }}</h2>

          {% if form.posted_successfully? %}
            <p class="form-status form-status--success" tabindex="-1">
              {% if blog.moderated? %}
                {{ 'blog.comment_pending' | t }}
              {% else %}
                {{ 'blog.comment_posted' | t }}
              {% endif %}
            </p>
          {% endif %}
          {{ form.errors | default_errors }}

          <div class="form-grid form-grid--two">
            <div class="field">
              <label for="CommentAuthor-{{ section.id }}">{{ 'blog.comment_form_name' | t }}</label>
              <input
                id="CommentAuthor-{{ section.id }}"
                type="text"
                name="comment[author]"
                value="{{ form.author | escape }}"
                autocomplete="name"
                required
              >
            </div>
            <div class="field">
              <label for="CommentEmail-{{ section.id }}">{{ 'blog.comment_form_email' | t }}</label>
              <input
                id="CommentEmail-{{ section.id }}"
                type="email"
                name="comment[email]"
                value="{{ form.email | escape }}"
                autocomplete="email"
                required
              >
            </div>
          </div>
          <div class="field">
            <label for="CommentBody-{{ section.id }}">{{ 'blog.comment_form_body' | t }}</label>
            <textarea id="CommentBody-{{ section.id }}" name="comment[body]" rows="8" required>{{ form.body | escape }}</textarea>
          </div>
          <button class="button" type="submit">{{ 'blog.comment_form_submit' | t }}</button>
        {% endform %}
      </div>
    </section>
  {% endif %}

  <footer class="article-main__footer page-width">
    <a class="button button--secondary" href="{{ blog.url }}">{{ 'blog.back_to_blog' | t }}</a>
  </footer>
</article>

{% stylesheet %}
  .article-main {
    padding-block: clamp(4rem, 10vw, 9rem);
  }

  .article-main__header {
    display: grid;
    max-width: min(78rem, calc(var(--page-width) + (var(--page-margin) * 2)));
    gap: 1.2rem;
    margin-block-end: clamp(2rem, 6vw, 5rem);
  }

  .article-main__header h1 {
    max-width: 14ch;
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.88;
  }

  .article-main__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article-main__hero {
    overflow: hidden;
    margin-block-end: clamp(3rem, 8vw, 7rem);
  }

  .article-main__hero .image,
  .article-main__hero img {
    width: 100%;
    max-height: 78vh;
  }

  .article-main__hero img {
    object-fit: cover;
  }

  .article-main__body,
  .article-comments__inner {
    max-width: min(52rem, calc(var(--page-width) + (var(--page-margin) * 2)));
  }

  .article-main__content {
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
  }

  .article-main__share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    border-block-start: 1px solid var(--border-subtle);
    margin-block-start: 3rem;
    padding-block-start: 1.25rem;
  }

  .article-main__routes {
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
    margin-block-start: clamp(4rem, 10vw, 9rem);
  }

  .article-route {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    border-block-start: 1px solid var(--border-subtle);
    padding-block-start: 1.25rem;
  }

  .article-route__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .article-route__header h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 5vw, 5rem);
    line-height: 0.9;
  }

  .article-route__stories,
  .article-route__products {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 750px) {
    .article-route__stories {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .article-route__products {
      grid-template-columns: repeat(var(--related-product-columns, 3), minmax(0, 1fr));
    }
  }

  .article-comments {
    margin-block-start: clamp(4rem, 10vw, 9rem);
  }

  .article-comments__inner,
  .article-comments__list,
  .article-comment-form {
    display: grid;
    gap: 1.5rem;
  }

  .article-comment {
    margin: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--card-radius);
    padding: 1.5rem;
  }

  .article-comment footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 1rem;
    font-size: 0.78rem;
  }

  .article-comment-form {
    border-block-start: 1px solid var(--border-subtle);
    margin-block-start: 2rem;
    padding-block-start: 2rem;
  }

  .article-main__footer {
    max-width: min(52rem, calc(var(--page-width) + (var(--page-margin) * 2)));
    margin-block-start: 3rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "full_width_image",
      "label": "Use full-width image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show sharing links",
      "default": true
    },
    {
      "type": "header",
      "content": "Related content"
    },
    {
      "type": "checkbox",
      "id": "show_related_articles",
      "label": "Show related stories",
      "default": true
    },
    {
      "type": "blog",
      "id": "related_blog",
      "label": "Related stories blog",
      "info": "Uses the current blog when no blog is selected."
    },
    {
      "type": "text",
      "id": "related_articles_heading",
      "label": "Related stories heading",
      "default": "More from the journal"
    },
    {
      "type": "range",
      "id": "related_articles_count",
      "label": "Related stories to show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_related_products",
      "label": "Show related products",
      "default": true
    },
    {
      "type": "collection",
      "id": "related_collection",
      "label": "Related products collection"
    },
    {
      "type": "text",
      "id": "related_products_heading",
      "label": "Related products heading",
      "default": "Shop the story"
    },
    {
      "type": "range",
      "id": "related_products_count",
      "label": "Related products to show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}
