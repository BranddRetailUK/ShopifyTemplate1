{% render 'section-background-override', section: section %}

{% liquid
  assign recommendation_heading = section.settings.heading
  if recommendation_heading == blank
    if section.settings.intent == 'complementary'
      assign recommendation_heading = 'products.recommendations.complementary' | t
    else
      assign recommendation_heading = 'products.recommendations.related' | t
    endif
  endif
%}

<product-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
>
  <div data-recommendations-content>
    {% if recommendations.performed? and recommendations.products_count > 0 %}
      <section
        class="product-recommendations section scheme-{{ section.settings.scheme }}"
        data-nav-tone="{% if section.settings.scheme == 'paper' or section.settings.scheme == 'signal' %}light{% else %}dark{% endif %}"
      >
        <div class="page-width">
          <div class="section-header" data-reveal>
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
            <h2>{{ recommendation_heading }}</h2>
          </div>
          <div
            class="product-grid"
            style="--product-grid-columns: {{ section.settings.columns_desktop }}"
          >
            {% for recommendation in recommendations.products %}
              {% render 'product-card', product: recommendation %}
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}
  </div>
</product-recommendations>

{% stylesheet %}
  .product-recommendations .product-grid {
    display: grid;
    grid-template-columns: repeat(var(--product-grid-columns, 4), minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  @media (max-width: 989px) {
    .product-recommendations .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Continue exploring"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom background"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Override preset background",
      "info": "Uses the color below for this section instead of the selected color scheme background.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
