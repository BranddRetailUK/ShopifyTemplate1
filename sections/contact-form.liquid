{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section class="contact-main section scheme-{{ section.settings.scheme }}" data-nav-tone="{{ nav_tone }}">
  <div class="page-width contact-main__inner">
    <header class="contact-main__header" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1>{{ page.title | default: section.settings.heading | escape }}</h1>
      {% if section.settings.text != blank %}
        <div class="rte">{{ section.settings.text }}</div>
      {% elsif page.content != blank %}
        <div class="rte">{{ page.content }}</div>
      {% endif %}
    </header>

    {% form 'contact', class: 'contact-main__form' %}
      {% if form.posted_successfully? %}
        <p class="form-status form-status--success" tabindex="-1">{{ 'contact.success' | t }}</p>
      {% endif %}
      {{ form.errors | default_errors }}

      <div class="form-grid form-grid--two">
        <div class="field">
          <label for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
          <input
            id="ContactName-{{ section.id }}"
            type="text"
            name="contact[name]"
            value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
            autocomplete="name"
          >
        </div>
        <div class="field">
          <label for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
          <input
            id="ContactEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
            autocapitalize="off"
            autocomplete="email"
            required
          >
        </div>
      </div>
      <div class="field">
        <label for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
        <input
          id="ContactPhone-{{ section.id }}"
          type="tel"
          name="contact[phone]"
          value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
          autocomplete="tel"
        >
      </div>
      <div class="field">
        <label for="ContactBody-{{ section.id }}">{{ 'contact.message' | t }}</label>
        <textarea id="ContactBody-{{ section.id }}" name="contact[body]" rows="9" required>{{ form.body | escape }}</textarea>
      </div>
      <button class="button" type="submit">{{ 'contact.send' | t }}</button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .contact-main__inner {
    display: grid;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .contact-main__header {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .contact-main__header h1 {
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.86;
  }

  .contact-main__form {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 990px) {
    .contact-main__inner {
      grid-template-columns: minmax(0, 0.85fr) minmax(28rem, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start a conversation"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell us what you need and our team will get back to you.</p>"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
