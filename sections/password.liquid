{% render 'section-background-override', section: section %}

<section
  class="password-page scheme-{{ section.settings.scheme }}"
  data-nav-tone="{% if section.settings.scheme == 'ink' or section.settings.scheme == 'electric' %}dark{% else %}light{% endif %}"
  {% if section.settings.image %}
    style="--password-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  {% endif %}
>
  {% if section.settings.image %}
    <div class="password-page__media">
      {% render 'image',
        image: section.settings.image,
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        width: 2400
      %}
    </div>
  {% endif %}

  <div class="password-page__overlay"></div>
  <div class="password-page__inner page-width">
    <header class="password-page__brand">
      {% if settings.logo %}
        {{
          settings.logo
          | image_url: width: settings.logo_width
          | image_tag: widths: '120, 180, 240, 360', width: settings.logo_width, alt: shop.name
        }}
      {% else %}
        <span>{{ shop.name | escape }}</span>
      {% endif %}
    </header>

    <div class="password-page__content" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      {% if shop.password_message != blank %}
        <div class="rte">{{ shop.password_message }}</div>
      {% elsif section.settings.text != blank %}
        <div class="rte">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.show_newsletter %}
        {% form 'customer', class: 'password-page__newsletter' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {% if form.posted_successfully? %}
            <p class="form-status form-status--success" tabindex="-1">{{ 'newsletter.success' | t }}</p>
          {% endif %}
          {{ form.errors | default_errors }}
          <div class="password-page__newsletter-fields">
            <label class="visually-hidden" for="PasswordNewsletter-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
            <input
              id="PasswordNewsletter-{{ section.id }}"
              type="email"
              name="contact[email]"
              placeholder="{{ 'newsletter.email' | t }}"
              autocapitalize="off"
              autocomplete="email"
              required
            >
            <button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>
          </div>
        {% endform %}
      {% endif %}
    </div>

    <details class="password-page__entry">
      <summary>{{ 'password.enter' | t }}</summary>
      {% form 'storefront_password', class: 'password-page__form' %}
        {{ form.errors | default_errors }}
        <div class="field">
          <label for="PasswordInput-{{ section.id }}">{{ 'password.password' | t }}</label>
          <input
            id="PasswordInput-{{ section.id }}"
            type="password"
            name="password"
            autocomplete="current-password"
            required
          >
        </div>
        <button class="button" type="submit">{{ 'password.enter' | t }}</button>
      {% endform %}
    </details>
  </div>
</section>

{% stylesheet %}
  .password-page {
    position: relative;
    min-height: 100svh;
    isolation: isolate;
  }

  .password-page__media,
  .password-page__overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .password-page__media .image,
  .password-page__media img {
    width: 100%;
    height: 100%;
  }

  .password-page__media img {
    object-fit: cover;
  }

  .password-page__overlay {
    z-index: -1;
    background: rgb(0 0 0 / var(--password-overlay, 0));
  }

  .password-page__inner {
    display: grid;
    min-height: 100svh;
    grid-template-rows: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    padding-block: 2rem;
  }

  .password-page__brand {
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    font-weight: var(--font-heading-weight);
  }

  .password-page__brand img {
    width: auto;
    max-height: 4rem;
  }

  .password-page__content {
    display: grid;
    max-width: 62rem;
    justify-items: start;
    gap: 1.25rem;
  }

  .password-page__content h1 {
    max-width: 12ch;
    font-size: clamp(4rem, 13vw, 11rem);
    line-height: 0.8;
  }

  .password-page__newsletter {
    width: min(100%, 42rem);
  }

  .password-page__newsletter-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.6rem;
  }

  .password-page__entry {
    position: relative;
    justify-self: end;
  }

  .password-page__entry summary {
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: underline;
  }

  .password-page__form {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: calc(100% + 0.75rem);
    display: grid;
    width: min(22rem, calc(100vw - (var(--page-margin) * 2)));
    gap: 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--card-radius);
    background: var(--scheme-background);
    color: var(--scheme-foreground);
    padding: 1.25rem;
  }

  @media (max-width: 749px) {
    .password-page__newsletter-fields {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "ink"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something good is on the way."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Join the list for launch news and first access.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email signup",
      "default": true
    }
  ]
}
{% endschema %}
