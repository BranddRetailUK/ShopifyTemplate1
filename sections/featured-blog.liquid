{% render 'section-background-override', section: section %}

{% liquid
  assign selected_blog = section.settings.blog
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section
  class="featured-blog section scheme-{{ section.settings.scheme }}"
  data-nav-tone="{{ nav_tone }}"
  style="--blog-columns: {{ section.settings.columns_desktop }};"
>
  <div class="page-width">
    <header class="section-header section-header--with-action" data-reveal>
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ section.settings.heading | default: selected_blog.title | escape }}</h2>
      </div>
      {% if selected_blog != blank and section.settings.show_view_all %}
        <a class="text-link" href="{{ selected_blog.url }}">{{ 'general.view_all' | t }}</a>
      {% endif %}
    </header>

    <div class="featured-blog__grid">
      {% if selected_blog != blank %}
        {% for article in selected_blog.articles limit: section.settings.articles_to_show %}
          {% render 'article-card',
            article: article,
            show_author: section.settings.show_author,
            show_date: section.settings.show_date,
            show_excerpt: section.settings.show_excerpt
          %}
        {% endfor %}
      {% else %}
        {% for index in (1..3) %}
          <article class="article-card card" data-reveal>
            <div class="article-card__media">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="article-card__content">
              <h2>{{ 'onboarding.article_title' | t }}</h2>
              <p>{{ 'onboarding.choose_blog' | t }}</p>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .featured-blog__grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 750px) {
    .featured-blog__grid {
      grid-template-columns: repeat(var(--blog-columns, 3), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured blog",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom background"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Override preset background",
      "info": "Uses the color below for this section instead of the selected color scheme background.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From the journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ideas, objects, and ways of working."
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Articles to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured blog"
    }
  ]
}
{% endschema %}
