{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section class="media-text section scheme-{{ section.settings.scheme }}" data-nav-tone="{{ nav_tone }}">
  <div class="page-width media-text__inner media-text__inner--{{ section.settings.media_position }}">
    <div class="media-text__media media-text__media--{{ section.settings.media_ratio }}" data-reveal>
      {% if section.settings.video %}
        {{
          section.settings.video
          | video_tag:
            autoplay: section.settings.autoplay,
            loop: section.settings.autoplay,
            muted: section.settings.autoplay,
            controls: true,
            playsinline: true,
            image_size: '1600x'
        }}
      {% elsif section.settings.image %}
        {% render 'image',
          image: section.settings.image,
          sizes: '(min-width: 990px) 55vw, 100vw',
          width: 1800
        %}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <div class="media-text__content" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .media-text__inner {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 7vw, 8rem);
  }

  .media-text__media {
    overflow: hidden;
    min-height: 22rem;
    border-radius: var(--media-radius);
    background: color-mix(in srgb, currentcolor 6%, transparent);
  }

  .media-text__media--portrait {
    aspect-ratio: 4 / 5;
  }

  .media-text__media--square {
    aspect-ratio: 1;
  }

  .media-text__media--landscape {
    aspect-ratio: 4 / 3;
  }

  .media-text__media .image,
  .media-text__media img,
  .media-text__media video,
  .media-text__media .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .media-text__media img,
  .media-text__media video {
    object-fit: cover;
  }

  .media-text__content {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.25rem;
  }

  .media-text__content h2 {
    max-width: 14ch;
    font-size: clamp(2.8rem, 6vw, 6.5rem);
    line-height: 0.88;
  }

  .media-text__content .rte {
    max-width: 54ch;
  }

  @media (min-width: 990px) {
    .media-text__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(22rem, 0.9fr);
    }

    .media-text__inner--right .media-text__media {
      grid-column: 2;
    }

    .media-text__inner--right .media-text__content {
      grid-column: 1;
      grid-row: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Media with text",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom background"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Override preset background",
      "info": "Uses the color below for this section instead of the selected color scheme background.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Video replaces the image."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": false
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Behind the product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Show the thinking behind what you make."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pair strong imagery with the details customers need to understand your materials, process, or point of view.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read the story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Media with text"
    }
  ]
}
{% endschema %}
