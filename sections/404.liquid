{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section class="not-found section scheme-{{ section.settings.scheme }}" data-nav-tone="{{ nav_tone }}">
  <div class="page-width not-found__inner" data-reveal>
    <p class="not-found__code" aria-hidden="true">404</p>
    <p class="eyebrow">{{ '404.title' | t }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p>{{ '404.not_found' | t }}</p>

    <form class="not-found__search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="options[prefix]" value="last">
      <label class="visually-hidden" for="NotFoundSearch-{{ section.id }}">{{ 'search.title' | t }}</label>
      <input
        id="NotFoundSearch-{{ section.id }}"
        type="search"
        name="q"
        placeholder="{{ 'search.placeholder' | t }}"
      >
      <button class="button" type="submit">{{ 'search.submit' | t }}</button>
    </form>

    <div class="button-group">
      <a class="button button--secondary" href="{{ routes.root_url }}">{{ '404.back_home' | t }}</a>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
    </div>
  </div>
</section>

{% stylesheet %}
  .not-found {
    min-height: max(36rem, calc(100svh - var(--header-height)));
  }

  .not-found__inner {
    display: grid;
    max-width: min(58rem, calc(var(--page-width) + (var(--page-margin) * 2)));
    justify-items: start;
    gap: 1.25rem;
  }

  .not-found__code {
    margin-block-end: -2rem;
    font-family: var(--font-heading-family);
    font-size: clamp(7rem, 24vw, 18rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: -0.1em;
    line-height: 0.72;
    opacity: 0.1;
  }

  .not-found__inner h1 {
    font-size: clamp(2.8rem, 8vw, 7rem);
    line-height: 0.9;
  }

  .not-found__search {
    display: grid;
    width: min(100%, 42rem);
    grid-template-columns: 1fr auto;
    gap: 0.7rem;
  }

  @media (max-width: 749px) {
    .not-found__search {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page not found",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "signal"
    },
    {
      "type": "header",
      "content": "Custom background"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Override preset background",
      "info": "Uses the color below for this section instead of the selected color scheme background.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This page took a wrong turn."
    }
  ]
}
{% endschema %}
