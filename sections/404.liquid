{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif

  assign recovery_collection = section.settings.collection
  assign shop_route = routes.all_products_collection_url
  if recovery_collection != blank
    assign shop_route = recovery_collection.url
  endif
%}

<section class="not-found section scheme-{{ section.settings.scheme }}" data-nav-tone="{{ nav_tone }}">
  <div class="page-width">
    <div class="not-found__hero" data-reveal>
      <p class="not-found__code" aria-hidden="true">404</p>

      <div class="not-found__content">
        <p class="eyebrow">{{ '404.title' | t }}</p>
        <h1>{{ section.settings.heading | escape }}</h1>
        <p class="not-found__message">{{ '404.not_found' | t }}</p>

        <form class="not-found__search" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="options[prefix]" value="last">
          <label class="visually-hidden" for="NotFoundSearch-{{ section.id }}">{{ 'search.title' | t }}</label>
          <input
            id="NotFoundSearch-{{ section.id }}"
            type="search"
            name="q"
            placeholder="{{ 'search.placeholder' | t }}"
          >
          <button class="button" type="submit">{{ 'search.submit' | t }}</button>
        </form>

        <div class="button-group">
          <a class="button button--secondary" href="{{ routes.root_url }}">{{ '404.back_home' | t }}</a>
          <a class="button" href="{{ shop_route }}">{{ '404.back_to_shopping' | t }}</a>
        </div>
      </div>
    </div>

    {% if section.settings.show_products and recovery_collection != blank and recovery_collection.products_count > 0 %}
      <section class="not-found__collection" aria-labelledby="RecoveryCollection-{{ section.id }}">
        <header class="not-found__collection-header">
          <h2 id="RecoveryCollection-{{ section.id }}">
            {% if section.settings.collection_heading != blank %}
              {{ section.settings.collection_heading | escape }}
            {% else %}
              {{ recovery_collection.title | escape }}
            {% endif %}
          </h2>
          <a class="text-link" href="{{ recovery_collection.url }}">{{ 'general.view_all' | t }}</a>
        </header>

        <div class="not-found__products">
          {% for recovery_product in recovery_collection.products limit: 3 %}
            {% render 'product-card',
              product: recovery_product,
              index: forloop.index,
              heading_level: 'h3'
            %}
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .not-found {
    min-height: max(36rem, calc(100svh - var(--header-height)));
  }

  .not-found__hero {
    display: grid;
    align-items: end;
    gap: clamp(1rem, 4vw, 4rem);
    min-height: min(44rem, 72svh);
    padding-block-end: clamp(3rem, 8vw, 7rem);
    border-block-end: 1px solid var(--border-subtle);
  }

  .not-found__code {
    align-self: start;
    font-family: var(--font-heading-family);
    font-size: clamp(8rem, 28vw, 22rem);
    font-weight: var(--font-heading-weight);
    letter-spacing: -0.1em;
    line-height: 0.68;
    opacity: 0.11;
  }

  .not-found__content {
    display: grid;
    max-width: 48rem;
    justify-items: start;
    gap: 1.25rem;
  }

  .not-found__content h1 {
    max-width: 11ch;
    font-size: clamp(2.8rem, 7vw, 7rem);
    line-height: 0.88;
  }

  .not-found__message {
    max-width: 42ch;
  }

  .not-found__search {
    display: grid;
    width: min(100%, 42rem);
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.7rem;
  }

  .not-found__collection {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block-start: clamp(3rem, 8vw, 7rem);
  }

  .not-found__collection-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .not-found__collection-header h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 5vw, 5rem);
    line-height: 0.9;
  }

  .not-found__products {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 750px) {
    .not-found__hero {
      grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    }

    .not-found__products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .not-found__hero {
      min-height: 0;
    }

    .not-found__search {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page not found",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "signal"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This page took a wrong turn."
    },
    {
      "type": "header",
      "content": "Recovery collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show three products",
      "default": true
    },
    {
      "type": "text",
      "id": "collection_heading",
      "label": "Collection heading",
      "info": "Uses the collection title when left blank."
    }
  ]
}
{% endschema %}
