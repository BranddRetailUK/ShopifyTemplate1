{% liquid
  assign result_count = 0
  if predictive_search.performed
    assign result_count = predictive_search.resources.products.size
    assign result_count = result_count | plus: predictive_search.resources.collections.size
    assign result_count = result_count | plus: predictive_search.resources.pages.size
    assign result_count = result_count | plus: predictive_search.resources.articles.size
    assign result_count = result_count | plus: predictive_search.resources.queries.size
  endif
%}

<div id="PredictiveSearchResults" data-result-count="{{ result_count }}">
  {% if predictive_search.performed %}

    {% if result_count > 0 %}
      <div class="predictive-search__grid" role="presentation">
        {% if predictive_search.resources.queries.size > 0 %}
          <div
            class="predictive-search__group"
            role="group"
            aria-labelledby="PredictiveQueriesHeading-{{ section.id }}"
          >
            <h2 id="PredictiveQueriesHeading-{{ section.id }}" role="presentation">{{ 'search.suggestions' | t }}</h2>
            <ul role="presentation">
              {% for query in predictive_search.resources.queries %}
                <li role="presentation">
                  <a
                    id="PredictiveQuery-{{ section.id }}-{{ forloop.index }}"
                    href="{{ query.url }}"
                    role="option"
                    tabindex="-1"
                    aria-selected="false"
                  >
                    {{ query.styled_text }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% if predictive_search.resources.products.size > 0 %}
          <div
            class="predictive-search__group predictive-search__products"
            role="group"
            aria-labelledby="PredictiveProductsHeading-{{ section.id }}"
          >
            <h2 id="PredictiveProductsHeading-{{ section.id }}" role="presentation">{{ 'search.products' | t }}</h2>
            <ul role="presentation">
              {% for product in predictive_search.resources.products %}
                <li role="presentation">
                  <a
                    id="PredictiveProduct-{{ section.id }}-{{ product.id }}"
                    href="{{ product.url }}"
                    role="option"
                    tabindex="-1"
                    aria-selected="false"
                  >
                    {% if product.featured_image %}
                      {{
                        product.featured_image
                        | image_url: width: 160
                        | image_tag:
                          widths: '80, 120, 160',
                          sizes: '64px',
                          loading: 'lazy',
                          alt: product.featured_image.alt
                      }}
                    {% endif %}
                    <span>
                      <strong>{{ product.title | escape }}</strong>
                      <small>{{ product.price | money }}</small>
                    </span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% if predictive_search.resources.collections.size > 0 %}
          <div
            class="predictive-search__group"
            role="group"
            aria-labelledby="PredictiveCollectionsHeading-{{ section.id }}"
          >
            <h2 id="PredictiveCollectionsHeading-{{ section.id }}" role="presentation">{{ 'search.collections' | t }}</h2>
            <ul role="presentation">
              {% for collection in predictive_search.resources.collections %}
                <li role="presentation">
                  <a
                    id="PredictiveCollection-{{ section.id }}-{{ collection.id }}"
                    href="{{ collection.url }}"
                    role="option"
                    tabindex="-1"
                    aria-selected="false"
                  >
                    {{ collection.title | escape }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% if predictive_search.resources.pages.size > 0 or predictive_search.resources.articles.size > 0 %}
          <div
            class="predictive-search__group"
            role="group"
            aria-labelledby="PredictiveContentHeading-{{ section.id }}"
          >
            <h2 id="PredictiveContentHeading-{{ section.id }}" role="presentation">{{ 'search.stories_and_pages' | t }}</h2>
            <ul role="presentation">
              {% for page in predictive_search.resources.pages %}
                <li role="presentation">
                  <a
                    id="PredictivePage-{{ section.id }}-{{ page.id }}"
                    href="{{ page.url }}"
                    role="option"
                    tabindex="-1"
                    aria-selected="false"
                  >
                    {{ page.title | escape }}
                  </a>
                </li>
              {% endfor %}
              {% for article in predictive_search.resources.articles %}
                <li role="presentation">
                  <a
                    id="PredictiveArticle-{{ section.id }}-{{ article.id }}"
                    href="{{ article.url }}"
                    role="option"
                    tabindex="-1"
                    aria-selected="false"
                  >
                    {{ article.title | escape }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <a
      class="button button--secondary predictive-search__view-all"
      href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last"
      id="PredictiveViewAll-{{ section.id }}"
      role="option"
      tabindex="-1"
      aria-selected="false"
    >
      {{ 'search.view_all' | t: terms: predictive_search.terms }}
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .predictive-search__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .predictive-search__group {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .predictive-search__group h2 {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .predictive-search__group ul {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .predictive-search__group a {
    border-radius: var(--input-radius);
    text-decoration: none;
  }

  .predictive-search__group a[aria-selected='true'] {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .predictive-search__view-all[aria-selected='true'] {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .predictive-search__products {
    grid-row: span 2;
  }

  .predictive-search__products a {
    display: grid;
    grid-template-columns: 64px 1fr;
    align-items: center;
    gap: 0.75rem;
  }

  .predictive-search__products img {
    width: 64px;
    height: 78px;
    border-radius: 4px;
    object-fit: cover;
  }

  .predictive-search__products span {
    display: grid;
    gap: 0.25rem;
  }

  .predictive-search__view-all {
    width: 100%;
    margin-block-start: 1.5rem;
  }

  @media (max-width: 649px) {
    .predictive-search__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
