{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section class="logo-list section scheme-{{ section.settings.scheme }}" data-nav-tone="{{ nav_tone }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="logo-list__heading eyebrow" data-reveal>{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <div class="logo-list__grid" style="--logo-columns: {{ section.settings.columns_desktop }};">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% else %}<div {{ block.shopify_attributes }}>{% endif %}
          {% if block.settings.logo %}
            {{
              block.settings.logo
              | image_url: width: 500
              | image_tag:
                widths: '120, 180, 240, 360, 500',
                sizes: '(min-width: 750px) 180px, 120px',
                loading: 'lazy',
                alt: block.settings.name
            }}
          {% else %}
            <span>{{ block.settings.name | escape }}</span>
          {% endif %}
        {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .logo-list__heading {
    margin-block-end: 2rem;
    text-align: center;
  }

  .logo-list__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block-start: 1px solid var(--border-subtle);
    border-inline-start: 1px solid var(--border-subtle);
  }

  .logo-list__grid > * {
    display: grid;
    min-height: 8rem;
    place-items: center;
    border-block-end: 1px solid var(--border-subtle);
    border-inline-end: 1px solid var(--border-subtle);
    padding: 1.5rem;
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-weight: var(--font-heading-weight);
    text-align: center;
    text-decoration: none;
  }

  .logo-list__grid img {
    width: auto;
    max-width: 11rem;
    max-height: 4rem;
    object-fit: contain;
  }

  @media (min-width: 750px) {
    .logo-list__grid {
      grid-template-columns: repeat(var(--logo-columns, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Logo list",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As seen with"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "500 x 200px .png recommended"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Partner name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
