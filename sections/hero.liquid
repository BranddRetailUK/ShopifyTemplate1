{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = section.settings.nav_tone
  assign has_media = false
  if section.settings.video != blank or section.settings.image != blank
    assign has_media = true
  endif
%}

<section
  class="hero-section hero-section--{{ section.settings.height }} hero-section--{{ section.settings.content_position }} scheme-{{ section.settings.scheme }}"
  data-nav-tone="{{ nav_tone }}"
  data-nav-tone-manual="true"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-content-width: {{ section.settings.content_width }}rem;"
>
  {% if has_media %}
    <div class="hero-section__media">
      {% if section.settings.video %}
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            image_size: '2400x'
        }}
      {% else %}
        {% render 'image',
          image: section.settings.image,
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          width: 2600
        %}
      {% endif %}
    </div>
    <div class="hero-section__overlay"></div>
  {% endif %}

  <div class="page-width hero-section__inner">
    <div class="hero-section__content" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1>{{ section.settings.heading | escape }}</h1>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte hero-section__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.primary_label != blank or section.settings.secondary_label != blank %}
        <div class="button-group">
          {% if section.settings.primary_label != blank %}
            <a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
              {{ section.settings.primary_label | escape }}
            </a>
          {% endif %}
          {% if section.settings.secondary_label != blank %}
            <a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.root_url }}">
              {{ section.settings.secondary_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_accents %}
    <span class="hero-section__accent hero-section__accent--one" aria-hidden="true"></span>
    <span class="hero-section__accent hero-section__accent--two" aria-hidden="true"></span>
  {% endif %}
</section>

{% stylesheet %}
  .hero-section {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-section--small {
    min-height: 34rem;
  }

  .hero-section--medium {
    min-height: 48rem;
  }

  .hero-section--large {
    min-height: 60rem;
  }

  .hero-section--full {
    min-height: calc(100svh - var(--header-height));
  }

  .hero-section__media,
  .hero-section__overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .hero-section__media .image,
  .hero-section__media img,
  .hero-section__media video {
    width: 100%;
    height: 100%;
  }

  .hero-section__media img,
  .hero-section__media video {
    object-fit: cover;
  }

  .hero-section__overlay {
    z-index: -1;
    background: rgb(0 0 0 / var(--hero-overlay));
  }

  .hero-section__inner {
    display: flex;
    min-height: inherit;
    align-items: flex-end;
    padding-block: clamp(4rem, 10vw, 9rem);
  }

  .hero-section--top-left .hero-section__inner,
  .hero-section--top-center .hero-section__inner {
    align-items: flex-start;
  }

  .hero-section--center-left .hero-section__inner,
  .hero-section--center .hero-section__inner {
    align-items: center;
  }

  .hero-section--top-center .hero-section__inner,
  .hero-section--center .hero-section__inner,
  .hero-section--bottom-center .hero-section__inner {
    justify-content: center;
    text-align: center;
  }

  .hero-section--top-center .button-group,
  .hero-section--center .button-group,
  .hero-section--bottom-center .button-group {
    justify-content: center;
  }

  .hero-section__content {
    display: grid;
    width: min(100%, var(--hero-content-width));
    justify-items: start;
    gap: 1.25rem;
  }

  .hero-section--top-center .hero-section__content,
  .hero-section--center .hero-section__content,
  .hero-section--bottom-center .hero-section__content {
    justify-items: center;
  }

  .hero-section__content h1 {
    max-width: 13ch;
    font-size: clamp(3.6rem, 10vw, 10rem);
    line-height: 0.82;
  }

  .hero-section__text {
    max-width: 58ch;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
  }

  .hero-section__accent {
    position: absolute;
    z-index: -1;
    width: 70vw;
    height: clamp(0.7rem, 1.5vw, 1.4rem);
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
    transform-origin: center;
    pointer-events: none;
  }

  .hero-section__accent--one {
    inset-block-start: 26%;
    inset-inline-end: -14%;
    transform: rotate(-10deg);
  }

  .hero-section__accent--two {
    inset-block-end: 17%;
    inset-inline-start: -18%;
    transform: rotate(13deg);
  }

  @media (max-width: 749px) {
    .hero-section--medium,
    .hero-section--large {
      min-height: 42rem;
    }

    .hero-section__content h1 {
      font-size: clamp(3.2rem, 17vw, 6.4rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom background"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Override preset background",
      "info": "Uses the color below for this section instead of the selected color scheme background.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "nav_tone",
      "label": "Header tone",
      "options": [
        { "value": "light", "label": "Dark header content" },
        { "value": "dark", "label": "Light header content" }
      ],
      "default": "light"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "2000 x 1400px recommended"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Video replaces the image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Media overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give your products room to speak."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Introduce the collection, material, or point of view that makes your brand different.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "center-left", "label": "Center left" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "rem",
      "default": 68
    },
    {
      "type": "checkbox",
      "id": "show_accents",
      "label": "Show graphic accents",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
