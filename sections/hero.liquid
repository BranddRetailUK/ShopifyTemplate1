{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = section.settings.nav_tone
  assign has_media = false
  assign heading_tag = section.settings.heading_level | default: 'h1'
  assign autoplay_media = true
  if settings.motion_level == 'none'
    assign autoplay_media = false
  endif
  if section.settings.video != blank or section.settings.image != blank or section.settings.layout == 'editorial'
    assign has_media = true
  endif
%}

<section
  class="hero-section hero-section--{{ section.settings.height }} hero-section--{{ section.settings.content_position }} hero-section--{{ section.settings.layout }} scheme-{{ section.settings.scheme }}"
  data-nav-tone="{{ nav_tone }}"
  data-nav-tone-manual="true"
  style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-content-width: {{ section.settings.content_width }}rem;"
>
  {% if has_media %}
    <div class="hero-section__media hero-section__media--{{ section.settings.layout }}">
      {% if section.settings.video %}
        {{
          section.settings.video
          | video_tag:
            autoplay: autoplay_media,
            loop: true,
            muted: true,
            controls: true,
            playsinline: true,
            class: 'motion-aware-media',
            image_size: '2400x'
        }}
      {% elsif section.settings.layout == 'editorial' %}
        <div class="hero-section__editorial-media hero-section__editorial-media--primary">
          {% if section.settings.image %}
            {% render 'image',
              image: section.settings.image,
              sizes: '(min-width: 990px) 68vw, 72vw',
              loading: 'eager',
              fetchpriority: 'high',
              width: 2200
            %}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <div class="hero-section__editorial-media hero-section__editorial-media--secondary">
          {% if section.settings.secondary_image %}
            {% render 'image',
              image: section.settings.secondary_image,
              sizes: '(min-width: 990px) 30vw, 42vw',
              loading: 'eager',
              width: 1200
            %}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <div class="hero-section__edition" aria-hidden="true">
          <span>MODE / {{ 'now' | date: '%y' }}</span>
          <span>FRAME 01</span>
        </div>
      {% else %}
        {% render 'image',
          image: section.settings.image,
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          width: 2600
        %}
      {% endif %}
    </div>
    <div class="hero-section__overlay"></div>
  {% endif %}

  <div class="page-width hero-section__inner">
    <div class="hero-section__content" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <{{ heading_tag }}>{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte hero-section__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.primary_label != blank or section.settings.secondary_label != blank %}
        <div class="button-group">
          {% if section.settings.primary_label != blank %}
            <a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
              {{ section.settings.primary_label | escape }}
            </a>
          {% endif %}
          {% if section.settings.secondary_label != blank %}
            <a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.root_url }}">
              {{ section.settings.secondary_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_accents %}
    <span class="hero-section__accent hero-section__accent--one" aria-hidden="true"></span>
    <span class="hero-section__accent hero-section__accent--two" aria-hidden="true"></span>
  {% endif %}
</section>

{% stylesheet %}
  .hero-section {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-section--small {
    min-height: 34rem;
  }

  .hero-section--medium {
    min-height: 48rem;
  }

  .hero-section--large {
    min-height: 60rem;
  }

  .hero-section--full {
    min-height: calc(100svh - var(--header-height));
  }

  .hero-section__media,
  .hero-section__overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .hero-section__media .image,
  .hero-section__media img,
  .hero-section__media video {
    width: 100%;
    height: 100%;
  }

  .hero-section__media img,
  .hero-section__media video {
    object-fit: cover;
  }

  .hero-section__media--editorial {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(14rem, 0.72fr);
    gap: clamp(0.5rem, 1.2vw, 1rem);
    padding: clamp(0.5rem, 1.2vw, 1rem);
    background: var(--scheme-background);
  }

  .hero-section__editorial-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--media-radius);
  }

  .hero-section__editorial-media .image,
  .hero-section__editorial-media :is(img, .placeholder-svg) {
    width: 100%;
    height: 100%;
  }

  .hero-section__editorial-media :is(img, .placeholder-svg) {
    object-fit: cover;
  }

  .hero-section__editorial-media--secondary {
    margin-block: clamp(4rem, 10vh, 8rem) clamp(2rem, 6vh, 5rem);
  }

  .hero-section__edition {
    position: absolute;
    z-index: 2;
    inset-block-start: clamp(1rem, 2vw, 2rem);
    inset-inline: clamp(1rem, 2vw, 2rem);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .hero-section__overlay {
    z-index: -1;
    background: rgb(0 0 0 / var(--hero-overlay));
  }

  .hero-section__inner {
    display: flex;
    min-height: inherit;
    align-items: flex-end;
    padding-block: clamp(4rem, 10vw, 9rem);
  }

  .hero-section--top-left .hero-section__inner,
  .hero-section--top-center .hero-section__inner {
    align-items: flex-start;
  }

  .hero-section--center-left .hero-section__inner,
  .hero-section--center .hero-section__inner {
    align-items: center;
  }

  .hero-section--top-center .hero-section__inner,
  .hero-section--center .hero-section__inner,
  .hero-section--bottom-center .hero-section__inner {
    justify-content: center;
    text-align: center;
  }

  .hero-section--top-center .button-group,
  .hero-section--center .button-group,
  .hero-section--bottom-center .button-group {
    justify-content: center;
  }

  .hero-section__content {
    display: grid;
    width: min(100%, var(--hero-content-width));
    justify-items: start;
    gap: 1.25rem;
  }

  .hero-section--top-center .hero-section__content,
  .hero-section--center .hero-section__content,
  .hero-section--bottom-center .hero-section__content {
    justify-items: center;
  }

  .hero-section__content :is(h1, h2) {
    max-width: 13ch;
    font-size: clamp(3.6rem, 10vw, 10rem);
    line-height: 0.82;
  }

  .hero-section--editorial .hero-section__content {
    width: min(100%, 54rem);
    border: 1px solid currentcolor;
    border-radius: var(--card-radius);
    background: color-mix(in srgb, var(--scheme-background) 90%, transparent);
    backdrop-filter: blur(14px);
    color: var(--scheme-foreground);
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .hero-section__text {
    max-width: 58ch;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
  }

  .hero-section__accent {
    position: absolute;
    z-index: -1;
    width: 70vw;
    height: clamp(0.7rem, 1.5vw, 1.4rem);
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
    transform-origin: center;
    pointer-events: none;
  }

  .hero-section__accent--one {
    inset-block-start: 26%;
    inset-inline-end: -14%;
    transform: rotate(-10deg);
  }

  .hero-section__accent--two {
    inset-block-end: 17%;
    inset-inline-start: -18%;
    transform: rotate(13deg);
  }

  @media (max-width: 749px) {
    .hero-section--medium,
    .hero-section--large {
      min-height: 42rem;
    }

    .hero-section__content :is(h1, h2) {
      font-size: clamp(3.2rem, 17vw, 6.4rem);
    }

    .hero-section__media--editorial {
      grid-template-columns: minmax(0, 1.45fr) minmax(7rem, 0.55fr);
    }

    .hero-section__editorial-media--secondary {
      margin-block: 5rem 10rem;
    }

    .hero-section--editorial .hero-section__inner {
      align-items: flex-end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "nav_tone",
      "label": "Header tone",
      "options": [
        { "value": "light", "label": "Dark header content" },
        { "value": "dark", "label": "Light header content" }
      ],
      "default": "light"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Primary image",
      "info": "2000 x 1400px recommended"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Secondary image",
      "info": "Used by the editorial frame layout."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Media layout",
      "options": [
        { "value": "editorial", "label": "Editorial frame" },
        { "value": "single", "label": "Single image or video" }
      ],
      "default": "editorial"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Video replaces the image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Media overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "New collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Form follows feeling."
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A photo-led opening for apparel, objects, and the people who put them into motion.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "center-left", "label": "Center left" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "rem",
      "default": 68
    },
    {
      "type": "checkbox",
      "id": "show_accents",
      "label": "Show graphic accents",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
