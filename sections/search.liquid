{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section
  class="search-page section scheme-{{ section.settings.scheme }}"
  data-nav-tone="{{ nav_tone }}"
  style="
    --desktop-columns: {{ section.settings.columns_desktop }};
    --mobile-columns: {{ section.settings.columns_mobile }};
    --grid-gap: {{ section.settings.grid_gap }}px;
  "
>
  <div class="page-width">
    <header class="search-page__header" data-reveal>
      <p class="eyebrow">{{ 'search.title' | t }}</p>
      <h1>
        {% if search.performed %}
          {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
        {% else %}
          {{ section.settings.heading | escape }}
        {% endif %}
      </h1>

      <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
        {% if section.settings.product_results_only %}
          <input type="hidden" name="type" value="product">
        {% endif %}
        <input type="hidden" name="options[prefix]" value="last">
        <label class="visually-hidden" for="SearchPageInput-{{ section.id }}">{{ 'search.title' | t }}</label>
        <input
          id="SearchPageInput-{{ section.id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
        >
        <button class="button" type="submit">
          {% render 'icon', name: 'search' %}
          {{ 'search.submit' | t }}
        </button>
      </form>
    </header>

    {% if search.performed %}
      {% paginate search.results by section.settings.results_per_page %}
        {% render 'facets',
          results: search,
          enable_filtering: section.settings.enable_filtering,
          enable_sorting: section.settings.enable_sorting,
          id_prefix: section.id
        %}

        {% if search.results_count == 0 %}
          <div class="empty-state">
            <h2>{{ 'search.no_results_html' | t: terms: search.terms }}</h2>
            <p>{{ 'search.try_again' | t }}</p>
          </div>
          {% if section.settings.no_results_collection != blank %}
            <div class="search-page__discovery">
              <header class="section-header section-header--with-action">
                <div>
                  <p class="eyebrow">{{ 'search.continue_exploring' | t }}</p>
                  <h2>{{ section.settings.no_results_collection.title }}</h2>
                </div>
                <a class="text-link" href="{{ section.settings.no_results_collection.url }}">
                  {{ 'general.view_all' | t }}
                </a>
              </header>
              <div class="product-grid">
                {% for product in section.settings.no_results_collection.products limit: 4 %}
                  {% render 'product-card', product: product, index: forloop.index %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% else %}
          <p class="results-count" role="status">
            {{ 'search.result_count' | t: count: search.results_count }}
          </p>
          <div class="search-results">
            {% for result in search.results %}
              {% if result.object_type == 'product' %}
                {% liquid
                  assign eager_card = false
                  if forloop.index <= section.settings.columns_desktop
                    assign eager_card = true
                  endif
                %}
                {% render 'product-card',
                  product: result,
                  eager: eager_card,
                  heading_level: 'h2',
                  index: forloop.index
                %}
              {% else %}
                {% liquid
                  assign result_image = result.image
                  assign result_type = result.object_type
                  if result_type == 'article'
                    assign result_type_label = 'search.article' | t
                  elsif result_type == 'page'
                    assign result_type_label = 'search.page' | t
                  else
                    assign result_type_label = 'search.collection' | t
                  endif
                %}
                <article class="search-card card" data-reveal>
                  <a class="search-card__media" href="{{ result.url }}">
                    {% if result_image %}
                      {% render 'image',
                        image: result_image,
                        sizes: '(min-width: 990px) 33vw, 100vw',
                        width: 1200
                      %}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </a>
                  <div class="search-card__content">
                    <p class="eyebrow">{{ result_type_label }}</p>
                    <h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2>
                    {% if result.content != blank %}
                      <p>{{ result.content | strip_html | truncatewords: 24 }}</p>
                    {% endif %}
                    <a class="text-link" href="{{ result.url }}">{{ 'general.read_more' | t }}</a>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
          {% render 'pagination', paginate: paginate %}
        {% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .search-page__header {
    display: grid;
    max-width: 72rem;
    gap: 1.25rem;
    margin-block-end: clamp(2rem, 6vw, 5rem);
  }

  .search-page__header h1 {
    font-size: clamp(2.8rem, 7vw, 7rem);
    line-height: 0.9;
  }

  .search-page__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.7rem;
    max-width: 52rem;
  }

  .search-page__form .icon {
    width: 1rem;
  }

  .search-results {
    display: grid;
    grid-template-columns: repeat(var(--mobile-columns, 1), minmax(0, 1fr));
    gap: var(--grid-gap, 1rem);
  }

  .search-card {
    display: grid;
    min-width: 0;
  }

  .search-card__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: color-mix(in srgb, currentcolor 6%, transparent);
  }

  .search-card__media .image,
  .search-card__media img,
  .search-card__media .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .search-card__media img {
    object-fit: cover;
  }

  .search-card__content {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
  }

  .search-card__content h2 {
    font-size: clamp(1.35rem, 2.8vw, 2.5rem);
  }

  .search-card__content h2 a {
    text-decoration: none;
  }

  .search-page__discovery {
    padding-block-start: clamp(2rem, 6vw, 5rem);
  }

  @media (min-width: 750px) {
    .search-results {
      grid-template-columns: repeat(var(--desktop-columns, 3), minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .search-page__form {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "collection",
      "id": "no_results_collection",
      "label": "No-results collection"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What are you looking for?"
    },
    {
      "type": "checkbox",
      "id": "product_results_only",
      "label": "Search products only",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "info": "Configure filters in the Shopify Search and Discovery app.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ]
}
{% endschema %}
