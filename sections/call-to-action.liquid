{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section class="cta-section section scheme-{{ section.settings.scheme }}" data-nav-tone="{{ nav_tone }}">
  {% if section.settings.image %}
    <div class="cta-section__media">
      {% render 'image', image: section.settings.image, sizes: '100vw', width: 2200 %}
    </div>
    <div class="cta-section__overlay" style="--cta-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {% endif %}
  <div class="page-width cta-section__inner" data-reveal>
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <div class="rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>
    {% if section.settings.button_label != blank %}
      <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label | escape }}
        {% render 'icon', name: 'arrow' %}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cta-section {
    position: relative;
    isolation: isolate;
  }

  .cta-section__media,
  .cta-section__overlay {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .cta-section__media .image,
  .cta-section__media img {
    width: 100%;
    height: 100%;
  }

  .cta-section__media img {
    object-fit: cover;
  }

  .cta-section__overlay {
    z-index: -1;
    background: rgb(0 0 0 / var(--cta-overlay));
  }

  .cta-section__inner {
    display: grid;
    align-items: end;
    gap: 2rem;
  }

  .cta-section__inner > div {
    display: grid;
    gap: 1.25rem;
  }

  .cta-section__inner h2 {
    max-width: 14ch;
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.86;
  }

  .cta-section__inner .rte {
    max-width: 56ch;
  }

  .cta-section__inner > .button {
    justify-self: start;
  }

  .cta-section__inner .button .icon {
    width: 1rem;
  }

  @media (min-width: 990px) {
    .cta-section__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .cta-section__inner > .button {
      justify-self: end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Call to action",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "ink"
    },
    {
      "type": "header",
      "content": "Custom background"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Override preset background",
      "info": "Uses the color below for this section instead of the selected color scheme background.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find your next favourite"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready when you are."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Call to action"
    }
  ]
}
{% endschema %}
