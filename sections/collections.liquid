{% render 'section-background-override', section: section %}

{% liquid
  assign nav_tone = 'light'
  if section.settings.scheme == 'ink' or section.settings.scheme == 'electric'
    assign nav_tone = 'dark'
  endif
%}

<section
  class="collections-main section scheme-{{ section.settings.scheme }}{% if section.settings.stagger_cards %} collections-main--staggered{% endif %}"
  data-nav-tone="{{ nav_tone }}"
  style="--desktop-columns: {{ section.settings.columns_desktop }}; --mobile-columns: {{ section.settings.columns_mobile }}; --grid-gap: {{ section.settings.grid_gap }}px;"
>
  <div class="page-width">
    <header class="collections-main__header" data-reveal>
      <div class="collections-main__title">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h1>
          {% if section.settings.heading != blank %}
            {{ section.settings.heading | escape }}
          {% else %}
            {{ 'collections.title' | t }}
          {% endif %}
        </h1>
      </div>
      {% if section.settings.text != blank %}
        <div class="rte collections-main__intro">{{ section.settings.text }}</div>
      {% endif %}
    </header>

    {% paginate collections by section.settings.collections_per_page %}
      <div class="collections-main__grid">
        {% for collection in collections %}
          {% liquid
            assign is_featured = false
            assign card_class = ''
            if section.settings.feature_first_collection and forloop.first
              assign is_featured = true
            elsif section.settings.stagger_cards
              assign position_modulo = forloop.index | modulo: 3
              if position_modulo == 0
                assign card_class = 'collection-card--portrait'
              endif
            endif
          %}
          {% render 'collection-card',
            collection: collection,
            show_count: section.settings.show_product_count,
            show_description: section.settings.show_collection_description,
            featured: is_featured,
            eager: is_featured,
            index: forloop.index,
            class: card_class
          %}
        {% else %}
          {% if request.design_mode %}
            {% for index in (1..3) %}
              <article class="collection-card card{% if index == 1 %} collection-card--featured{% endif %}" data-reveal>
                <div class="collection-card__media">
                  {{ 'collection-' | append: index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="collection-card__content">
                  <h2>{{ 'collections.collection' | t }}</h2>
                </div>
              </article>
            {% endfor %}
          {% else %}
            <div class="empty-state collections-main__empty">
              <h2>{{ 'collections.all' | t }}</h2>
              <a class="button" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</section>

{% stylesheet %}
  .collections-main__header {
    display: grid;
    align-items: end;
    gap: 1.5rem;
    margin-block-end: clamp(2.5rem, 7vw, 6rem);
    padding-block-end: 1.25rem;
    border-block-end: 1px solid var(--border-subtle);
  }

  .collections-main__title {
    display: grid;
    gap: 0.75rem;
  }

  .collections-main__header h1 {
    max-width: 10ch;
    font-size: clamp(3rem, 9vw, 8rem);
    line-height: 0.86;
  }

  .collections-main__intro {
    max-width: 34rem;
  }

  .collections-main__grid {
    display: grid;
    grid-template-columns: repeat(var(--mobile-columns, 1), minmax(0, 1fr));
    gap: var(--grid-gap, 1rem);
  }

  .collections-main__grid > .collection-card--featured,
  .collections-main__empty {
    grid-column: 1 / -1;
  }

  @media (min-width: 750px) {
    .collections-main__header {
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
    }

    .collections-main__grid {
      grid-template-columns: repeat(var(--desktop-columns, 3), minmax(0, 1fr));
      row-gap: clamp(2.5rem, 6vw, 7rem);
    }

    .collections-main__grid > .collection-card--featured {
      margin-block-end: clamp(1.5rem, 4vw, 4rem);
    }
  }

  @media (min-width: 990px) {
    .collections-main--staggered .collections-main__grid > .collection-card--portrait {
      margin-block-start: clamp(2rem, 6vw, 6rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "ink", "label": "Ink" },
        { "value": "signal", "label": "Signal" },
        { "value": "electric", "label": "Electric" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Custom section color"
    },
    {
      "type": "checkbox",
      "id": "override_background_color",
      "label": "Use custom background",
      "info": "Text switches automatically between black and white to preserve readable contrast.",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Subheading",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "feature_first_collection",
      "label": "Feature first collection",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "stagger_cards",
      "label": "Use staggered collection layout",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "label": "Collections per page",
      "min": 6,
      "max": 36,
      "step": 3,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ]
}
{% endschema %}
