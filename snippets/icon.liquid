{% doc %}
  Renders an inline theme icon.

  @param {string} name - Icon name.
  @param {string} [class] - Optional CSS class.
{% enddoc %}

<svg
  class="{{ class }}"
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  {% case name %}
    {% when 'menu' %}
      <path d="M3 7h18M3 17h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {% when 'close' %}
      <path d="m5 5 14 14M19 5 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {% when 'search' %}
      <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
      <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {% when 'cart' %}
      <path d="M4 8h16l-1 12H5L4 8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M9 9V6a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    {% when 'chevron' %}
      <path d="m8 10 4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'arrow' %}
      <path d="M4 12h15M14 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'plus' %}
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {% when 'minus' %}
      <path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {% when 'check' %}
      <path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'filter' %}
      <path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {% when 'play' %}
      <path d="m9 7 8 5-8 5V7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    {% when 'instagram' %}
      <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
    {% when 'youtube' %}
      <path d="M20 8.2a2.5 2.5 0 0 0-1.7-1.8C16.8 6 12 6 12 6s-4.8 0-6.3.4A2.5 2.5 0 0 0 4 8.2 26 26 0 0 0 3.7 12 26 26 0 0 0 4 15.8a2.5 2.5 0 0 0 1.7 1.8C7.2 18 12 18 12 18s4.8 0 6.3-.4a2.5 2.5 0 0 0 1.7-1.8 26 26 0 0 0 .3-3.8 26 26 0 0 0-.3-3.8Z" stroke="currentColor" stroke-width="1.5"/>
      <path d="m10 9 5 3-5 3V9Z" fill="currentColor"/>
    {% when 'facebook' %}
      <path d="M14 21v-8h3l.5-3H14V8.4c0-1 .4-1.9 1.8-1.9H18V4a28 28 0 0 0-2.7-.2c-2.7 0-4.6 1.7-4.6 4.8V10H8v3h2.7v8H14Z" fill="currentColor"/>
    {% when 'x' %}
      <path d="M5 4h3.8l3.7 5.2L17 4h2l-5.6 6.7L20 20h-3.8l-4.1-5.8L7 20H5l6.2-7.3L5 4Zm3 1.5L17 18.5h1L9 5.5H8Z" fill="currentColor"/>
    {% when 'tiktok' %}
      <path d="M14 4v10.3a4.2 4.2 0 1 1-3.5-4.1v2.4a1.9 1.9 0 1 0 1.2 1.7V4H14Zm0 0c.4 2 1.7 3.3 3.8 3.7V10A7.2 7.2 0 0 1 14 8.6V4Z" fill="currentColor"/>
    {% else %}
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8"/>
  {% endcase %}
</svg>
