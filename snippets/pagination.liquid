{% doc %}
  Renders pagination.

  @param {paginate} paginate - Shopify paginate object.
  @param {string} [anchor] - Optional URL anchor.
{% enddoc %}

{% if paginate.pages > 1 %}
  <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
    {% if paginate.previous %}
      <a href="{{ paginate.previous.url | append: anchor }}" aria-label="{{ 'accessibility.previous' | t }}">
        {% render 'icon', name: 'arrow', class: 'pagination__previous' %}
      </a>
    {% endif %}

    {% for part in paginate.parts %}
      {% if part.is_link %}
        <a href="{{ part.url | append: anchor }}">{{ part.title }}</a>
      {% else %}
        <span
          {% if part.title == paginate.current_page %}
            class="current"
            aria-current="page"
          {% endif %}
        >
          {{ part.title }}
        </span>
      {% endif %}
    {% endfor %}

    {% if paginate.next %}
      <a href="{{ paginate.next.url | append: anchor }}" aria-label="{{ 'accessibility.next' | t }}">
        {% render 'icon', name: 'arrow' %}
      </a>
    {% endif %}
  </nav>
{% endif %}

{% stylesheet %}
  .pagination svg {
    width: 1.1rem;
  }

  .pagination__previous {
    transform: rotate(180deg);
  }
{% endstylesheet %}
