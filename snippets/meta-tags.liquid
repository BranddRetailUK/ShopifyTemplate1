{%- liquid
  assign social_title = page_title | default: shop.name
  assign social_description = page_description | default: shop.description | default: shop.name
  assign social_url = canonical_url | default: request.origin
  assign social_type = 'website'

  if request.page_type == 'product'
    assign social_type = 'product'
  elsif request.page_type == 'article'
    assign social_type = 'article'
  elsif request.page_type == 'password'
    assign social_url = request.origin
  endif

  capture document_title
    echo page_title | default: shop.name
    if current_tags
      echo ' — '
      echo current_tags | join: ', '
    endif
    if current_page != 1
      echo ' — Page '
      echo current_page
    endif
    unless page_title contains shop.name
      echo ' — '
      echo shop.name
    endunless
  endcapture
-%}

<title>{{ document_title | strip | escape }}</title>
<link rel="canonical" href="{{ canonical_url }}">

{%- if social_description != blank -%}
  <meta name="description" content="{{ social_description | escape }}">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="{{ social_type }}">
<meta property="og:url" content="{{ social_url }}">
<meta property="og:title" content="{{ social_title | escape }}">
<meta property="og:description" content="{{ social_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  <meta name="twitter:card" content="summary_large_image">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}
<meta name="twitter:title" content="{{ social_title | escape }}">
<meta name="twitter:description" content="{{ social_description | escape }}">

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <script type="application/ld+json">{{ product | structured_data }}</script>
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">{{ article | structured_data }}</script>
{%- endif -%}
