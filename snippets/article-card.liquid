{% doc %}
  Renders an article card.

  @param {article} article - Article object.
  @param {boolean} [show_author] - Show author.
  @param {boolean} [show_date] - Show publication date.
  @param {boolean} [show_excerpt] - Show excerpt.
{% enddoc %}

<article class="article-card card" data-reveal>
  <a class="article-card__media" href="{{ article.url }}">
    {% if article.image %}
      {% render 'image',
        image: article.image,
        sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
        width: 1400
      %}
    {% else %}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </a>
  <div class="article-card__content">
    <div class="article-card__meta">
      {% if show_date %}
        {{ article.published_at | time_tag: format: 'date' }}
      {% endif %}
      {% if show_author %}
        <span>{{ article.author | escape }}</span>
      {% endif %}
    </div>
    <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
    {% if show_excerpt %}
      <p>{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
    {% endif %}
    <a class="text-link" href="{{ article.url }}">{{ 'blog.read_more' | t }}</a>
  </div>
</article>

{% stylesheet %}
  .article-card {
    display: grid;
    min-width: 0;
  }

  .article-card__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: color-mix(in srgb, currentcolor 6%, transparent);
  }

  .article-card__media .image,
  .article-card__media img,
  .article-card__media .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .article-card__media img {
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .article-card:hover .article-card__media img {
    transform: scale(1.025);
  }

  .article-card__content {
    display: grid;
    gap: 0.8rem;
    padding: 1rem;
  }

  .article-card__content h2 {
    font-size: clamp(1.4rem, 2.8vw, 2.5rem);
  }

  .article-card__content h2 a {
    text-decoration: none;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
{% endstylesheet %}
