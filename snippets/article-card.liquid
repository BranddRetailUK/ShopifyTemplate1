{% doc %}
  Renders an article card.

  @param {article} article - Article object.
  @param {boolean} [show_author] - Show author.
  @param {boolean} [show_date] - Show publication date.
  @param {boolean} [show_excerpt] - Show excerpt.
  @param {boolean} [featured] - Use the lead-story composition.
  @param {boolean} [eager] - Eager-load the article image.
  @param {number} [index] - Editorial position in the surrounding list.
  @param {string} [heading_level] - Heading tag. Defaults to h2.
  @param {string} [class] - Additional class names.
{% enddoc %}

{% liquid
  assign heading_tag = heading_level | default: 'h2'
  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  assign image_sizes = '(min-width: 1200px) 33vw, (min-width: 750px) 50vw, 100vw'
  if featured
    assign image_sizes = '(min-width: 990px) 62vw, 100vw'
  endif
  if eager
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
%}

<article
  class="article-card card{% if featured %} article-card--featured{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  data-reveal
>
  <a class="article-card__media" href="{{ article.url }}">
    {% if article.image %}
      {% render 'image',
        image: article.image,
        sizes: image_sizes,
        loading: loading,
        fetchpriority: fetchpriority,
        width: 1800
      %}
    {% else %}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    {% if index != blank %}
      <span class="article-card__index" aria-hidden="true">
        {{ index | prepend: '0' | slice: -2, 2 }}
      </span>
    {% endif %}
  </a>

  <div class="article-card__content">
    {% if show_date or show_author %}
      <div class="article-card__meta">
        {% if show_date %}
          {{ article.published_at | time_tag: format: 'date' }}
        {% endif %}
        {% if show_author %}
          <span>{{ article.author | escape }}</span>
        {% endif %}
      </div>
    {% endif %}

    <{{ heading_tag }}><a href="{{ article.url }}">{{ article.title | escape }}</a></{{ heading_tag }}>

    {% if show_excerpt %}
      <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
    {% endif %}

    <a class="text-link article-card__link" href="{{ article.url }}">{{ 'blog.read_more' | t }}</a>
  </div>
</article>

{% stylesheet %}
  .article-card {
    display: grid;
    min-width: 0;
    align-content: start;
  }

  .article-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: color-mix(in srgb, currentcolor 6%, transparent);
  }

  .article-card__media .modeframe-media,
  .article-card__media img,
  .article-card__media .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .article-card__media img {
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .article-card__index {
    position: absolute;
    inset-block-end: 0.8rem;
    inset-inline-start: 0.8rem;
    display: grid;
    min-width: 2.15rem;
    min-height: 2.15rem;
    place-items: center;
    border: 1px solid currentcolor;
    border-radius: 999px;
    background: var(--paper-background);
    color: var(--paper-foreground);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .article-card__content {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding: 1rem;
  }

  .article-card__content h2,
  .article-card__content h3 {
    max-width: 18ch;
    font-size: clamp(1.4rem, 2.8vw, 2.5rem);
    line-height: 0.98;
  }

  .article-card__content h2 a,
  .article-card__content h3 a {
    text-decoration: none;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .article-card__excerpt {
    max-width: 46ch;
    color: color-mix(in srgb, currentcolor 76%, transparent);
  }

  .article-card__link {
    justify-self: start;
    margin-block-start: auto;
  }

  .article-card--portrait .article-card__media {
    aspect-ratio: 4 / 5;
  }

  .article-card--compact .article-card__content {
    padding-inline: 0;
  }

  @media (hover: hover) {
    .article-card:hover .article-card__media img {
      transform: scale(1.025);
    }
  }

  .article-card:focus-within .article-card__media {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  @media (min-width: 990px) {
    .article-card--featured {
      grid-template-columns: minmax(0, 1.65fr) minmax(18rem, 0.75fr);
    }

    .article-card--featured .article-card__media {
      min-height: 32rem;
      aspect-ratio: 16 / 10;
    }

    .article-card--featured .article-card__content {
      align-content: end;
      padding: clamp(1.5rem, 3vw, 3rem);
    }

    .article-card--featured .article-card__content h2,
    .article-card--featured .article-card__content h3 {
      max-width: 12ch;
      font-size: clamp(2.5rem, 4.5vw, 5.5rem);
      line-height: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card__media img {
      transition: none;
    }
  }
{% endstylesheet %}
