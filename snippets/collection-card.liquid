{% doc %}
  Renders a collection card.

  @param {collection} collection - Collection object.
  @param {image} [image] - Optional image override.
  @param {boolean} [show_count] - Show the product count.
  @param {string} [class] - Additional class.
{% enddoc %}

{% liquid
  assign card_image = image | default: collection.featured_image
%}

<article class="collection-card card {{ class }}" data-reveal>
  <a class="collection-card__media" href="{{ collection.url }}">
    {% if card_image %}
      {% render 'image',
        image: card_image,
        sizes: '(min-width: 1200px) 33vw, (min-width: 750px) 50vw, 100vw',
        width: 1400
      %}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </a>

  <div class="collection-card__content">
    <div>
      <h2><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h2>
      {% if show_count %}
        <p class="eyebrow">{{ collection.products_count }} {{ 'collections.products' | t }}</p>
      {% endif %}
    </div>
    <a class="icon-link" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">
      {% render 'icon', name: 'arrow' %}
    </a>
  </div>
</article>

{% stylesheet %}
  .collection-card {
    display: grid;
    min-width: 0;
  }

  .collection-card__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: color-mix(in srgb, currentcolor 6%, transparent);
  }

  .collection-card__media .image,
  .collection-card__media img,
  .collection-card__media .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .collection-card__media img {
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-card:hover .collection-card__media img {
    transform: scale(1.025);
  }

  .collection-card__content {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
  }

  .collection-card__content h2 {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
  }

  .collection-card__content h2 a {
    text-decoration: none;
  }
{% endstylesheet %}
