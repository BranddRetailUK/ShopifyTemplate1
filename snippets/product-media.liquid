{% doc %}
  Renders rich Shopify product media.

  @param {media} media - Product media object.
  @param {boolean} [eager] - Eager-load the preview image.
  @param {string} [sizes] - Responsive sizes.
  @param {string} [id_prefix] - Unique media ID prefix.
{% enddoc %}

{% liquid
  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if eager
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
%}

<div
  id="ProductMedia-{{ id_prefix | default: 'Main' }}-{{ media.id }}"
  class="product-media__item"
  data-media-id="{{ media.id }}"
>
  {% case media.media_type %}
    {% when 'image' %}
      {% render 'image',
        image: media,
        sizes: sizes,
        loading: loading,
        fetchpriority: fetchpriority,
        width: 2000
      %}
    {% when 'external_video' %}
      <div class="product-media__video">
        {{ media | external_video_tag }}
      </div>
    {% when 'video' %}
      <div class="product-media__video">
        {{ media | media_tag: image_size: '1600x', controls: true, preload: 'metadata' }}
      </div>
    {% when 'model' %}
      <div class="product-media__model">
        {{ media | media_tag: image_size: '1600x', toggleable: true }}
      </div>
    {% else %}
      {{ media | media_tag }}
  {% endcase %}
</div>

{% stylesheet %}
  .product-media__item {
    overflow: hidden;
    border-radius: var(--card-radius);
    background: color-mix(in srgb, currentcolor 5%, transparent);
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }

  .product-media__video,
  .product-media__model {
    position: relative;
    min-height: 320px;
    aspect-ratio: 1 / 1;
  }

  .product-media__video iframe,
  .product-media__video video,
  .product-media__model model-viewer {
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}
