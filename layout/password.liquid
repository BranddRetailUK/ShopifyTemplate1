{% liquid
  assign browser_theme_color = settings.paper_background
  case settings.theme_preset
    when 'ink'
      assign browser_theme_color = settings.ink_background
    when 'signal'
      assign browser_theme_color = settings.signal_background
    when 'electric'
      assign browser_theme_color = settings.electric_background
    when 'all-light'
      assign browser_theme_color = settings.paper_background
    when 'all-dark'
      assign browser_theme_color = settings.ink_background
  endcase
%}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ browser_theme_color }}">
    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>
  <body
    class="theme-preset-{{ settings.theme_preset | default: 'paper' }}"
    data-theme-preset="{{ settings.theme_preset | default: 'paper' }}"
  >
    <a class="skip-link" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
