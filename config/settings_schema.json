[
  {
    "name": "theme_info",
    "theme_name": "Modeframe",
    "theme_version": "2.0.0",
    "theme_author": "Brandd",
    "theme_documentation_url": "https://github.com/BranddRetailUK/ShopifyTemplate1/blob/main/docs/merchant-guide.md",
    "theme_support_url": "https://brandd.co.uk/contact"
  },
  {
    "name": "Global styles",
    "settings": [
      {
        "type": "select",
        "id": "theme_preset",
        "label": "Art direction",
        "info": "Coordinates the four section color roles across the storefront.",
        "options": [
          {
            "value": "paper",
            "label": "Studio light"
          },
          {
            "value": "ink",
            "label": "Studio dark"
          },
          {
            "value": "signal",
            "label": "High signal"
          }
        ],
        "default": "paper"
      },
      {
        "type": "paragraph",
        "content": "Each art direction preserves contrast-tested Paper, Ink, Signal, and Electric section roles."
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "Logo for dark backgrounds",
        "info": "Optional. Uses the primary logo when left blank."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 320,
        "step": 8,
        "unit": "px",
        "label": "Logo width",
        "default": 176
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "Body font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n4",
        "label": "Heading font"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 2,
        "unit": "%",
        "label": "Body text scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 2,
        "unit": "%",
        "label": "Heading scale",
        "default": 106
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "min": -6,
        "max": 4,
        "step": 1,
        "unit": "%",
        "label": "Heading letter spacing",
        "default": -3
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1800,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "page_margin",
        "min": 12,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "Minimum page margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 40,
        "max": 160,
        "step": 8,
        "unit": "px",
        "label": "Section spacing",
        "default": 96
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Paper"
      },
      {
        "type": "color",
        "id": "paper_background",
        "label": "Background",
        "default": "#f6f4ef"
      },
      {
        "type": "color",
        "id": "paper_foreground",
        "label": "Foreground",
        "default": "#111111"
      },
      {
        "type": "header",
        "content": "Ink"
      },
      {
        "type": "color",
        "id": "ink_background",
        "label": "Background",
        "default": "#0d0d0f"
      },
      {
        "type": "color",
        "id": "ink_foreground",
        "label": "Foreground",
        "default": "#f7f7f2"
      },
      {
        "type": "header",
        "content": "Signal"
      },
      {
        "type": "color",
        "id": "signal_background",
        "label": "Background",
        "default": "#d9ff43"
      },
      {
        "type": "color",
        "id": "signal_foreground",
        "label": "Foreground",
        "default": "#101010"
      },
      {
        "type": "header",
        "content": "Electric"
      },
      {
        "type": "color",
        "id": "electric_background",
        "label": "Background",
        "default": "#6838ff"
      },
      {
        "type": "color",
        "id": "electric_foreground",
        "label": "Foreground",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Components",
    "settings": [
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 8
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 8
      },
      {
        "type": "range",
        "id": "media_radius",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "label": "Media corner radius",
        "default": 4
      },
      {
        "type": "range",
        "id": "input_radius",
        "min": 0,
        "max": 20,
        "step": 2,
        "unit": "px",
        "label": "Input corner radius",
        "default": 6
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "product_card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "product_card_show_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_card_show_swatches",
        "label": "Show native color swatches",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_card_quick_add",
        "label": "Enable quick add",
        "default": true
      }
    ]
  },
  {
    "name": "Search and cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Enable predictive search",
        "default": true
      },
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart interaction",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Show cart note",
        "default": true
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "reveal_on_scroll",
        "label": "Reveal sections on scroll",
        "default": true
      },
      {
        "type": "select",
        "id": "motion_level",
        "label": "Motion level",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "subtle",
            "label": "Subtle"
          },
          {
            "value": "expressive",
            "label": "Expressive"
          }
        ],
        "default": "subtle"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_x",
        "label": "X"
      }
    ]
  }
]
