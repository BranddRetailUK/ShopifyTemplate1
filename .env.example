# Browser QA target. Use an unpublished preview or dedicated demo store.
QA_BASE_URL=https://your-demo-store.myshopify.com
QA_STOREFRONT_PASSWORD=
QA_PREVIEW_THEME_ID=
QA_PRODUCT_PATH=/products/example-product
QA_COLLECTION_PATH=/collections/example-collection
QA_CONTENT_PATH=/pages/example-page
QA_SEARCH_TERM=example
# Release floors. These can be raised for stricter QA but not lowered.
QA_LIGHTHOUSE_MIN_PERFORMANCE=60
QA_LIGHTHOUSE_MIN_ACCESSIBILITY=90

# Optional Admin API values for the test-catalog helper.
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
