<section class="customer scheme-paper" data-nav-tone="light">
  <div class="page-width customer__inner">
    <header class="customer__header">
      <p class="eyebrow">{{ 'customer.account' | t }}</p>
      <h1>{{ customer.name | escape }}</h1>
      <div class="customer__actions">
        <a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }}</a>
        <a href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a>
      </div>
    </header>

    <div class="customer__grid customer__grid--two">
      <section class="customer__panel">
        <h2>{{ 'customer.order_history' | t }}</h2>
        {% paginate customer.orders by 20 %}
          {% if customer.orders.size > 0 %}
            <div class="customer__table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">{{ 'customer.order' | t }}</th>
                    <th scope="col">{{ 'customer.date' | t }}</th>
                    <th scope="col">{{ 'customer.payment_status' | t }}</th>
                    <th scope="col">{{ 'customer.fulfilment_status' | t }}</th>
                    <th scope="col">{{ 'customer.total' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% for order in customer.orders %}
                    <tr>
                      <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                      <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                      <td>{{ order.financial_status_label }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td>{{ order.total_net_amount | money_with_currency }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% render 'pagination', paginate: paginate %}
          {% else %}
            <p>{{ 'customer.no_orders' | t }}</p>
          {% endif %}
        {% endpaginate %}
      </section>

      <aside class="customer__panel">
        <h2>{{ 'customer.default_address' | t }}</h2>
        {% if customer.default_address %}
          {{ customer.default_address | format_address }}
          <a href="{{ routes.account_addresses_url }}">{{ 'customer.manage_addresses' | t }}</a>
        {% else %}
          <p>{{ 'customer.no_address' | t }}</p>
          <a class="button button--secondary" href="{{ routes.account_addresses_url }}">
            {{ 'customer.add_address' | t }}
          </a>
        {% endif %}
      </aside>
    </div>
  </div>
</section>
