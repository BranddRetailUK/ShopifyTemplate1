<section class="customer scheme-paper" data-nav-tone="light">
  <div class="page-width customer__inner">
    <header class="customer__header">
      <p class="eyebrow">{{ 'customer.account' | t }}</p>
      <h1>{{ 'customer.activate' | t }}</h1>
      <p>{{ 'customer.activate_text' | t }}</p>
    </header>

    {% form 'activate_customer_password', class: 'customer__form' %}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="ActivatePassword">{{ 'customer.password' | t }}</label>
        <input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ActivatePasswordConfirmation">{{ 'customer.password_confirmation' | t }}</label>
        <input
          id="ActivatePasswordConfirmation"
          type="password"
          name="customer[password_confirmation]"
          autocomplete="new-password"
          required
        >
      </div>
      <div class="customer__actions">
        <button class="button" type="submit">{{ 'customer.activate' | t }}</button>
        <button class="button button--secondary" type="submit" name="decline">{{ 'customer.decline' | t }}</button>
      </div>
    {% endform %}
  </div>
</section>
