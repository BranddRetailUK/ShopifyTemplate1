<section class="customer scheme-paper" data-nav-tone="light">
  <div class="page-width customer__inner">
    <header class="customer__header">
      <p class="eyebrow">{{ 'customer.account' | t }}</p>
      <h1>{{ 'customer.reset' | t }}</h1>
      <p>{{ 'customer.reset_text' | t }}</p>
    </header>

    {% form 'reset_customer_password', class: 'customer__form' %}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="ResetPassword">{{ 'customer.password' | t }}</label>
        <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetPasswordConfirmation">{{ 'customer.password_confirmation' | t }}</label>
        <input
          id="ResetPasswordConfirmation"
          type="password"
          name="customer[password_confirmation]"
          autocomplete="new-password"
          required
        >
      </div>
      <button class="button" type="submit">{{ 'customer.reset' | t }}</button>
    {% endform %}
  </div>
</section>
