{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.paper_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {% render 'meta-tags' %}

    {% style %}
      .gift-card-page {
        display: grid;
        min-height: 100svh;
        place-items: center;
        padding: var(--page-margin);
      }

      .gift-card {
        display: grid;
        width: min(100%, 40rem);
        justify-items: center;
        gap: 1.25rem;
        border: 1px solid var(--border-subtle);
        border-radius: var(--card-radius);
        background: var(--paper-background);
        color: var(--paper-foreground);
        padding: clamp(1.5rem, 6vw, 4rem);
        text-align: center;
      }

      .gift-card__brand img {
        width: auto;
        max-height: 4rem;
      }

      .gift-card__balance {
        font-size: clamp(3rem, 10vw, 7rem);
        line-height: 0.88;
      }

      .gift-card__visual {
        display: grid;
        width: 100%;
        min-height: 14rem;
        place-items: center;
        overflow: hidden;
        border-radius: var(--media-radius);
        background: var(--ink-background);
        color: var(--ink-foreground);
      }

      .gift-card__visual img {
        width: min(14rem, 70%);
      }

      .gift-card__code {
        border: 1px dashed currentcolor;
        border-radius: var(--input-radius);
        padding: 0.85rem 1rem;
        font-family: monospace;
        font-size: clamp(1rem, 4vw, 1.5rem);
        letter-spacing: 0.12em;
      }

      .gift-card__qr svg {
        width: 160px;
        height: 160px;
      }

      .gift-card__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.7rem;
      }

      .gift-card__wallet img {
        width: 10rem;
      }

      @media print {
        .gift-card__actions,
        .gift-card__wallet {
          display: none;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>
  <body class="scheme-paper">
    <main class="gift-card-page">
      <article class="gift-card">
        <header class="gift-card__brand">
          {% if settings.logo %}
            {{
              settings.logo
              | image_url: width: settings.logo_width
              | image_tag: widths: '120, 180, 240, 360', width: settings.logo_width, alt: shop.name
            }}
          {% else %}
            <h1>{{ shop.name | escape }}</h1>
          {% endif %}
        </header>

        <p class="eyebrow">{{ 'gift_card.card' | t }}</p>
        <h2 class="gift-card__balance">{{ gift_card.balance | money }}</h2>

        <div class="gift-card__visual">
          <img
            src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.card' | t }}"
            width="300"
            height="200"
          >
        </div>

        {% if gift_card.enabled == false or gift_card.expired %}
          <p class="form-status">{{ 'gift_card.expired' | t }}</p>
        {% endif %}

        {% if gift_card.expires_on %}
          {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
          <p>{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {% endif %}

        {% if gift_card.recipient %}
          <p>{{ 'gift_card.for_recipient' | t: recipient: gift_card.recipient.name }}</p>
        {% endif %}
        {% if gift_card.message != blank %}
          <div class="rte">{{ gift_card.message }}</div>
        {% endif %}
        {% if gift_card.send_on %}
          {% assign send_on = gift_card.send_on | date: '%B %e, %Y' %}
          <p>{{ 'gift_card.scheduled_for' | t: send_on: send_on }}</p>
        {% endif %}

        <p>{{ 'gift_card.use_at_checkout' | t }}</p>
        <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
        <div
          id="GiftCardQrCode"
          class="gift-card__qr"
          role="img"
          aria-label="{{ 'gift_card.qr_code' | t }}"
        ></div>
        <script>
          document.addEventListener('DOMContentLoaded', () => {
            new QRCode(document.getElementById('GiftCardQrCode'), {
              text: {{ gift_card.qr_identifier | json }},
              width: 160,
              height: 160
            });
          });
        </script>

        <div class="gift-card__actions">
          <button class="button" type="button" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
          <a class="button button--secondary" href="{{ shop.url }}">{{ 'general.continue_shopping' | t }}</a>
        </div>

        {% if gift_card.pass_url %}
          <a class="gift-card__wallet" href="{{ gift_card.pass_url }}" rel="nofollow">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="200"
              height="60"
            >
          </a>
        {% endif %}
      </article>
    </main>
  </body>
</html>
